<?xml version="1.0" encoding="UTF-8"?>
<MessageMapping xmlns="http://vermeg.com/banking/mapping" version="1.0">
  
  <!-- ============================================= -->
  <!-- GENERAL INFORMATION -->
  <!-- ============================================= -->
  <GeneralInformation>
    <MappingId>MAP_MT202_MT500_001</MappingId>
    <MappingName>MT202 to MT500 Conversion</MappingName>
    <Version>1.0.0</Version>
    <CreatedDate>2026-02-03</CreatedDate>
    <CreatedBy>Bilel SOUELMI - Vermeg FinTech Team</CreatedBy>
    <LastModifiedDate>2026-02-03</LastModifiedDate>
    <Status>ACTIVE</Status>
    
    <BusinessContext>
      <Description>
        Converts interbank payment message (MT202) to securities settlement instruction (MT500).
        Used in collateral management and treasury operations when cash payments need to be 
        linked with securities transactions.
      </Description>
      <UseCases>
        <UseCase>Collateral Management - Cash leg settlement</UseCase>
        <UseCase>Treasury Operations - Payment vs. Securities delivery</UseCase>
        <UseCase>Cross-border Securities Settlement</UseCase>
      </UseCases>
      <ApplicableDomains>Treasury, Securities Operations, Collateral Management</ApplicableDomains>
    </BusinessContext>
    
    <TechnicalSpecifications>
      <SourceFormat>SWIFT MT202 (ISO 15022)</SourceFormat>
      <TargetFormat>SWIFT MT500 (ISO 15022)</TargetFormat>
      <ProcessingMode>REAL_TIME</ProcessingMode>
      <AverageProcessingTime>200ms</AverageProcessingTime>
      <MaxProcessingTime>2000ms</MaxProcessingTime>
    </TechnicalSpecifications>
    
    <ComplianceRequirements>
      <Regulation>MiFID II - Transaction Reporting</Regulation>
      <Regulation>EMIR - Trade Repository Reporting</Regulation>
      <Regulation>GDPR - Data Protection</Regulation>
      <Regulation>SOX - Financial Controls</Regulation>
    </ComplianceRequirements>
  </GeneralInformation>
  
  <!-- ============================================= -->
  <!-- SOURCE MESSAGE STRUCTURE (MT202) -->
  <!-- ============================================= -->
  <SourceMessage>
    <MessageType>MT202</MessageType>
    <MessageName>General Financial Institution Transfer</MessageName>
    <Standard>SWIFT ISO 15022</Standard>
    
    <Fields>
      
      <!-- Field 1: Transaction Reference -->
      <Field id="FIELD_01">
        <FieldTag>:20:</FieldTag>
        <FieldName>Transaction Reference Number</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>16</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>ALPHANUMERIC</Format>
        <Description>Sender's reference for the transaction</Description>
        <ExampleValue>BNKREF2026020301</ExampleValue>
        <ValidationRules>
          <Rule>Must be alphanumeric</Rule>
          <Rule>Must be unique within sender's system</Rule>
          <Rule>Length between 1 and 16 characters</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 2: Related Reference -->
      <Field id="FIELD_02">
        <FieldTag>:21:</FieldTag>
        <FieldName>Related Reference</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>16</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>ALPHANUMERIC</Format>
        <Description>Reference to the related transaction</Description>
        <ExampleValue>RELREF2026020201</ExampleValue>
        <ValidationRules>
          <Rule>Must be alphanumeric</Rule>
          <Rule>References previous message in the chain</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 3: Value Date, Currency, Amount -->
      <Field id="FIELD_03">
        <FieldTag>:32A:</FieldTag>
        <FieldName>Value Date, Currency Code, Amount</FieldName>
        <DataType>COMPOSITE</DataType>
        <Format>YYMMDD[CCY][AMOUNT]</Format>
        <Mandatory>true</Mandatory>
        <Components>
          <Component name="ValueDate" type="DATE" format="YYMMDD"/>
          <Component name="Currency" type="STRING" format="ISO4217" length="3"/>
          <Component name="Amount" type="DECIMAL" format="15d"/>
        </Components>
        <Description>Settlement date, currency and amount</Description>
        <ExampleValue>250203USD1500000,00</ExampleValue>
        <ValidationRules>
          <Rule>Date must be valid business day</Rule>
          <Rule>Currency must be valid ISO 4217 code</Rule>
          <Rule>Amount must be positive</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 4: Ordering Institution (Option A) -->
      <Field id="FIELD_04">
        <FieldTag>:52A:</FieldTag>
        <FieldName>Ordering Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>BIC of the institution that orders the transfer</Description>
        <ExampleValue>BARCGB2LXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format (8 or 11 characters)</Rule>
          <Rule>Must exist in BIC directory</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 5: Ordering Institution (Option D) -->
      <Field id="FIELD_05">
        <FieldTag>:52D:</FieldTag>
        <FieldName>Ordering Institution (Name &amp; Address)</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>4*35x</Format>
        <Description>Name and address of ordering institution</Description>
        <ExampleValue>BARCLAYS BANK PLC
LONDON
UNITED KINGDOM</ExampleValue>
        <ValidationRules>
          <Rule>Maximum 4 lines of 35 characters each</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 6: Sender's Correspondent (Option A) -->
      <Field id="FIELD_06">
        <FieldTag>:53A:</FieldTag>
        <FieldName>Sender's Correspondent</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>BIC of sender's correspondent bank</Description>
        <ExampleValue>CITIUS33XXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 7: Receiver's Correspondent (Option A) -->
      <Field id="FIELD_07">
        <FieldTag>:54A:</FieldTag>
        <FieldName>Receiver's Correspondent</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>BIC of receiver's correspondent bank</Description>
        <ExampleValue>CHASUS33XXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 8: Intermediary Institution (Option A) -->
      <Field id="FIELD_08">
        <FieldTag>:56A:</FieldTag>
        <FieldName>Intermediary Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>BIC of intermediary bank in the payment chain</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 9: Account With Institution (Option A) -->
      <Field id="FIELD_09">
        <FieldTag>:57A:</FieldTag>
        <FieldName>Account With Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>BIC of institution where account is held</Description>
        <ExampleValue>BNPAFRPPXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 10: Beneficiary Institution (Option A) -->
      <Field id="FIELD_10">
        <FieldTag>:58A:</FieldTag>
        <FieldName>Beneficiary Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>true</Mandatory>
        <Description>BIC of the final beneficiary institution</Description>
        <ExampleValue>CHASUS33XXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
          <Rule>This field is mandatory</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 11: Sender to Receiver Information -->
      <Field id="FIELD_11">
        <FieldTag>:72:</FieldTag>
        <FieldName>Sender to Receiver Information</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>210</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>6*35x</Format>
        <Description>Additional information between sender and receiver</Description>
        <ExampleValue>/INS/US912828XK47
/SEC/US TREASURY BOND 2.5% 2035
/SETT/T+2</ExampleValue>
        <ValidationRules>
          <Rule>Maximum 6 lines of 35 characters each</Rule>
          <Rule>May contain structured codes</Rule>
        </ValidationRules>
      </Field>
      
    </Fields>
  </SourceMessage>
  
  <!-- ============================================= -->
  <!-- TARGET MESSAGE STRUCTURE (MT500) -->
  <!-- ============================================= -->
  <TargetMessage>
    <MessageType>MT500</MessageType>
    <MessageName>Instruction to Register</MessageName>
    <Standard>SWIFT ISO 15022</Standard>
    
    <Fields>
      
      <!-- Field 1: Sender's Message Reference -->
      <Field id="FIELD_01">
        <FieldTag>:20C::SEME//</FieldTag>
        <FieldName>Sender's Message Reference</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>16</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>ALPHANUMERIC</Format>
        <Description>Unique reference assigned by sender</Description>
        <ExampleValue>SECREF2026020301</ExampleValue>
      </Field>
      
      <!-- Field 2: Previous Message Reference -->
      <Field id="FIELD_02">
        <FieldTag>:20C::PREV//</FieldTag>
        <FieldName>Previous Reference</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>16</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>ALPHANUMERIC</Format>
        <Description>Reference to previous related message</Description>
        <ExampleValue>PREVREF202602</ExampleValue>
      </Field>
      
      <!-- Field 3: Function of the Message -->
      <Field id="FIELD_03">
        <FieldTag>:23G:</FieldTag>
        <FieldName>Function of the Message</FieldName>
        <DataType>CODE</DataType>
        <Format>4!c[/4c]</Format>
        <Mandatory>true</Mandatory>
        <Description>Indicates the function of the message</Description>
        <ExampleValue>NEWM</ExampleValue>
        <AllowedValues>
          <Value code="NEWM">New Message</Value>
          <Value code="CANC">Cancellation</Value>
          <Value code="REPL">Replacement</Value>
        </AllowedValues>
      </Field>
      
      <!-- Field 4: Identification of Financial Instrument -->
      <Field id="FIELD_04">
        <FieldTag>:35B:</FieldTag>
        <FieldName>Identification of the Financial Instrument</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Description and identification of the security</Description>
        <ExampleValue>ISIN US912828XK47
US TREASURY BOND 2.5% 15FEB2035</ExampleValue>
      </Field>
      
      <!-- Field 5: Settlement Date -->
      <Field id="FIELD_05">
        <FieldTag>:98A::SETT//</FieldTag>
        <FieldName>Settlement Date</FieldName>
        <DataType>DATE</DataType>
        <Format>YYYYMMDD</Format>
        <Mandatory>true</Mandatory>
        <Description>Date on which settlement is due</Description>
        <ExampleValue>20250203</ExampleValue>
      </Field>
      
      <!-- Field 6: Settlement Amount -->
      <Field id="FIELD_06">
        <FieldTag>:19A::SETT//</FieldTag>
        <FieldName>Settlement Amount</FieldName>
        <DataType>AMOUNT</DataType>
        <Format>[CCY][AMOUNT]</Format>
        <Mandatory>true</Mandatory>
        <Description>Amount to be settled</Description>
        <ExampleValue>USD1500000,00</ExampleValue>
      </Field>
      
      <!-- Field 7: Buyer -->
      <Field id="FIELD_07">
        <FieldTag>:95P::BUYR//</FieldTag>
        <FieldName>Buyer</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>true</Mandatory>
        <Description>Party that purchases the securities</Description>
        <ExampleValue>BARCGB2LXXX</ExampleValue>
      </Field>
      
      <!-- Field 8: Seller -->
      <Field id="FIELD_08">
        <FieldTag>:95P::SELL//</FieldTag>
        <FieldName>Seller</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>true</Mandatory>
        <Description>Party that sells the securities</Description>
        <ExampleValue>CHASUS33XXX</ExampleValue>
      </Field>
      
      <!-- Field 9: Place of Settlement -->
      <Field id="FIELD_09">
        <FieldTag>:95P::PSET//</FieldTag>
        <FieldName>Place of Settlement</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>true</Mandatory>
        <Description>Market infrastructure where settlement takes place</Description>
        <ExampleValue>DTCYUS33XXX</ExampleValue>
      </Field>
      
      <!-- Field 10: Delivering Agent -->
      <Field id="FIELD_10">
        <FieldTag>:95P::DEAG//</FieldTag>
        <FieldName>Delivering Agent</FieldName>
        <DataType>BIC</DataType>
        <Format>BIC11</Format>
        <Mandatory>false</Mandatory>
        <Description>Party delivering the securities</Description>
        <ExampleValue>BNPAFRPPXXX</ExampleValue>
      </Field>
      
      <!-- Field 11: Narrative -->
      <Field id="FIELD_11">
        <FieldTag>:70E::SPRO//</FieldTag>
        <FieldName>Settlement Parties Narrative</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>350</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Additional information about settlement parties</Description>
        <ExampleValue>LINKED TO PAYMENT MT202 REF BNKREF2026020301</ExampleValue>
      </Field>
      
    </Fields>
  </TargetMessage>
  
  <!-- ============================================= -->
  <!-- FIELD MAPPINGS -->
  <!-- ============================================= -->
  <FieldMappings>
    
    <!-- Mapping 1: Transaction Reference -->
    <Mapping id="MAPPING_01">
      <SourceField ref="FIELD_01"/>
      <TargetField ref="FIELD_01"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY</Type>
        <Expression>target.field_20C_SEME = source.field_20</Expression>
        <PseudoCode>
          // Direct copy of transaction reference
          target_reference = source_reference
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_20 != null AND source.field_20 != ""</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing transaction reference"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>LENGTH_VALIDATION</Type>
          <Expression>length(source.field_20) &lt;= 16</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE to 16 characters</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>FORMAT_VALIDATION</Type>
          <Expression>matches(source.field_20, "^[A-Z0-9]+$")</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid reference format"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>Message cannot be processed</ImpactIfFails>
        <BusinessRationale>Ensures traceability across payment and securities systems</BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE (direct copy)</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 2: Related Reference -->
    <Mapping id="MAPPING_02">
      <SourceField ref="FIELD_02"/>
      <TargetField ref="FIELD_02"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY</Type>
        <Expression>target.field_20C_PREV = source.field_21</Expression>
        <PseudoCode>
          // Copy related reference to previous reference
          target_prev_ref = source_related_ref
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_21 != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>SET_TO_EMPTY (field is optional in target)</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>LENGTH_VALIDATION</Type>
          <Expression>length(source.field_21) &lt;= 16</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE to 16 characters</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>Loss of audit trail but message processable</ImpactIfFails>
        <BusinessRationale>Maintains link to previous messages in transaction chain</BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 3: Amount -->
    <Mapping id="MAPPING_03">
      <SourceField ref="FIELD_03"/>
      <TargetField ref="FIELD_06"/>
      
      <MappingFormula>
        <Type>EXTRACTION_AND_REFORMATTING</Type>
        <Expression>
          currency = extract_currency(source.field_32A, position 7-9)
          amount = extract_amount(source.field_32A, position 10+)
          target.field_19A_SETT = format("{currency}{amount}", currency, amount)
        </Expression>
        <PseudoCode>
          // Extract currency and amount from composite field
          full_field = source.field_32A
          date_part = substring(full_field, 1, 6)     // YYMMDD
          currency_part = substring(full_field, 7, 3)  // CCY
          amount_part = substring(full_field, 10)      // AMOUNT
          
          // Format for target
          target_amount = currency_part + amount_part
          return target_amount
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_32A != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing amount information"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>FORMAT_VALIDATION</Type>
          <Expression>matches(source.field_32A, "^\d{6}[A-Z]{3}[\d,]+$")</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid amount format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>BUSINESS_RULE</Type>
          <Expression>extract_amount(source.field_32A) > 0</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Amount must be positive"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>CURRENCY_VALIDATION</Type>
          <Expression>is_valid_iso4217_currency(extract_currency(source.field_32A))</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid currency code"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Settlement cannot be executed - financial loss risk</ImpactIfFails>
        <BusinessRationale>Core financial amount for settlement calculation</BusinessRationale>
        <PerformanceImpact>LOW (string parsing required)</PerformanceImpact>
        <AuditRequirement>All amount conversions must be logged per SOX</AuditRequirement>
      </General>
    </Mapping>
    
    <!-- Mapping 4: Settlement Date -->
    <Mapping id="MAPPING_04">
      <SourceField ref="FIELD_03"/>
      <TargetField ref="FIELD_05"/>
      
      <MappingFormula>
        <Type>DATE_TRANSFORMATION</Type>
        <Expression>
          value_date_yy = extract_date(source.field_32A, position 1-6)
          century = determine_century(value_date_yy)
          target.field_98A_SETT = format_date_yyyymmdd(century + value_date_yy)
        </Expression>
        <PseudoCode>
          // Extract 2-digit year date and convert to 4-digit year
          date_string = substring(source.field_32A, 1, 6)  // YYMMDD
          year_2digit = substring(date_string, 1, 2)
          month = substring(date_string, 3, 2)
          day = substring(date_string, 5, 2)
          
          // Determine century (assume 20xx if YY >= 50, else 21xx)
          if (year_2digit >= 50) then
            century = "20"
          else
            century = "21"
          endif
          
          // Format as YYYYMMDD
          target_date = century + year_2digit + month + day
          return target_date
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATE_VALIDATION</Type>
          <Expression>is_valid_date(extract_date(source.field_32A))</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid settlement date"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BUSINESS_RULE</Type>
          <Expression>extract_date(source.field_32A) >= today()</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Settlement date cannot be in the past"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>BUSINESS_RULE</Type>
          <Expression>extract_date(source.field_32A) &lt;= today() + 5_business_days</Expression>
          <Action>PROCEED</Action>
          <ElseAction>WARNING "Settlement date exceeds T+5 standard"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>BUSINESS_DAY_CHECK</Type>
          <Expression>is_business_day(extract_date(source.field_32A), target_market)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>ADJUST to next business day AND LOG warning</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Missed settlement deadline - regulatory breach risk</ImpactIfFails>
        <BusinessRationale>Ensures securities and cash settle on same date (DVP)</BusinessRationale>
        <PerformanceImpact>MEDIUM (date validation + business day calendar lookup)</PerformanceImpact>
        <RegulatoryRequirement>CSDR Settlement Discipline (EU Regulation 909/2014)</RegulatoryRequirement>
      </General>
    </Mapping>
    
    <!-- Mapping 5: Buyer -->
    <Mapping id="MAPPING_05">
      <SourceField ref="FIELD_04"/>
      <TargetField ref="FIELD_07"/>
      
      <MappingFormula>
        <Type>SEMANTIC_MAPPING_WITH_FALLBACK</Type>
        <Expression>
          IF source.field_52A != null THEN
            target.field_95P_BUYR = source.field_52A
          ELSE IF source.field_52D != null THEN
            target.field_95P_BUYR = lookup_bic_from_name(source.field_52D)
          ELSE
            target.field_95P_BUYR = get_default_buyer_from_config()
          ENDIF
        </Expression>
        <PseudoCode>
          // Try option A first (BIC)
          if (source.field_52A is not null) then
            buyer_bic = source.field_52A
          // Fallback to option D (name/address lookup)
          else if (source.field_52D is not null) then
            institution_name = source.field_52D
            buyer_bic = reference_data_service.lookup_bic(institution_name)
            if (buyer_bic is null) then
              throw error "Cannot resolve BIC from institution name"
            endif
          // Last resort: use sender as default
          else
            buyer_bic = get_sender_bic()
          endif
          
          return buyer_bic
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATA_AVAILABILITY_CHECK</Type>
          <Expression>source.field_52A != null OR source.field_52D != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>USE_DEFAULT from sender information</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BIC_VALIDATION</Type>
          <Expression>is_valid_bic_format(source.field_52A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT if format invalid AND no fallback available</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>REFERENCE_DATA_CHECK</Type>
          <Expression>bic_exists_in_directory(source.field_52A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>LOG_WARNING "BIC not found in directory" AND PROCEED</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>SANCTIONS_SCREENING</Type>
          <Expression>NOT is_sanctioned_entity(source.field_52A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>BLOCK message AND ALERT compliance team</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Securities delivered to wrong party - operational risk</ImpactIfFails>
        <BusinessRationale>Identifies buyer for securities ownership transfer</BusinessRationale>
        <PerformanceImpact>MEDIUM (reference data lookup + sanctions check)</PerformanceImpact>
        <ComplianceRequirement>KYC verification required per AML regulations</ComplianceRequirement>
        <DataPrivacy>BIC codes are public but names may be PII under GDPR</DataPrivacy>
      </General>
    </Mapping>
    
    <!-- Mapping 6: Seller -->
    <Mapping id="MAPPING_06">
      <SourceField ref="FIELD_10"/>
      <TargetField ref="FIELD_08"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY_WITH_VALIDATION</Type>
        <Expression>target.field_95P_SELL = validate_and_copy(source.field_58A)</Expression>
        <PseudoCode>
          // Copy beneficiary as seller
          seller_bic = source.field_58A
          
          // Validate format
          if (NOT is_valid_bic(seller_bic)) then
            throw error "Invalid seller BIC format"
          endif
          
          // Check sanctions
          if (is_sanctioned(seller_bic)) then
            throw error "Seller is on sanctions list"
          endif
          
          return seller_bic
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_58A != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing beneficiary institution"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BIC_VALIDATION</Type>
          <Expression>is_valid_bic_format(source.field_58A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid BIC format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>SANCTIONS_SCREENING</Type>
          <Expression>NOT is_sanctioned_entity(source.field_58A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>BLOCK AND ALERT</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>ELIGIBILITY_CHECK</Type>
          <Expression>is_eligible_for_securities_settlement(source.field_58A)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Entity not eligible for securities settlement"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment sent to wrong party - financial loss</ImpactIfFails>
        <BusinessRationale>Identifies seller for securities ownership transfer</BusinessRationale>
        <PerformanceImpact>MEDIUM (validation + sanctions screening)</PerformanceImpact>
        <ComplianceRequirement>OFAC/EU Sanctions screening mandatory</ComplianceRequirement>
      </General>
    </Mapping>
    
    <!-- Mapping 7: Place of Settlement -->
    <Mapping id="MAPPING_07">
      <SourceField ref="FIELD_03"/>
      <TargetField ref="FIELD_09"/>
      
      <MappingFormula>
        <Type>DERIVATION_FROM_CURRENCY</Type>
        <Expression>
          currency = extract_currency(source.field_32A)
          target.field_95P_PSET = determine_settlement_system(currency)
        </Expression>
        <PseudoCode>
          // Determine settlement system based on currency
          currency = extract_currency_from_field_32A()
          
          // Lookup settlement system
          settlement_map = {
            "USD": "DTCYUS33XXX",  // DTC (US)
            "EUR": "CEDELULLXXX",  // Clearstream Luxembourg
            "GBP": "CRSTGB2LXXX",  // Crest (UK)
            "JPY": "JSDCJPJTXXX",  // JASDEC (Japan)
          }
          
          if (settlement_map.contains(currency)) then
            settlement_bic = settlement_map[currency]
          else
            // Default to Euroclear
            settlement_bic = "MGTCBEBEECL"
          endif
          
          return settlement_bic
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>CURRENCY_EXTRACTION</Type>
          <Expression>extract_currency(source.field_32A) != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Cannot determine settlement system"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>MAPPING_TABLE_LOOKUP</Type>
          <Expression>settlement_system_exists_for_currency(currency)</Expression>
          <Action>USE_MAPPED_SYSTEM</Action>
          <ElseAction>USE_DEFAULT_SYSTEM (Euroclear)</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>CONNECTIVITY_CHECK</Type>
          <Expression>is_connected_to_settlement_system(determined_system)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "No connectivity to required settlement system"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>Settlement routed to wrong system - fail or delay</ImpactIfFails>
        <BusinessRationale>Ensures settlement in correct CSD/ICSD</BusinessRationale>
        <PerformanceImpact>LOW (simple map lookup)</PerformanceImpact>
        <ConfigurationDependent>YES - requires settlement system mapping table</ConfigurationDependent>
      </General>
    </Mapping>
    
    <!-- Mapping 8: Message Function -->
    <Mapping id="MAPPING_08">
      <SourceField ref="NONE"/>
      <TargetField ref="FIELD_03"/>
      
      <MappingFormula>
        <Type>STATIC_DEFAULT</Type>
        <Expression>target.field_23G = "NEWM"</Expression>
        <PseudoCode>
          // Always set to NEW MESSAGE for MT202 to MT500 conversion
          message_function = "NEWM"
          return message_function
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>ALWAYS_TRUE</Type>
          <Expression>true</Expression>
          <Action>SET_TO_NEWM</Action>
          <ElseAction>N/A</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>Message rejected by receiving system</ImpactIfFails>
        <BusinessRationale>MT500 requires explicit message function code</BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
        <Note>Always NEWM unless specifically building cancellation flow</Note>
      </General>
    </Mapping>
    
    <!-- Mapping 9: Security Identification -->
    <Mapping id="MAPPING_09">
      <SourceField ref="FIELD_11"/>
      <TargetField ref="FIELD_04"/>
      
      <MappingFormula>
        <Type>EXTRACTION_WITH_ENRICHMENT</Type>
        <Expression>
          IF contains(source.field_72, '/INS/') THEN
            isin = extract_after(source.field_72, '/INS/')
            security_details = reference_data_service.get_security(isin)
            target.field_35B = format_security(isin, security_details)
          ELSE
            REJECT with error "No security identifier found"
          ENDIF
        </Expression>
        <PseudoCode>
          // Extract ISIN from field 72
          field_72_content = source.field_72
          
          if (field_72_content contains "/INS/") then
            // Extract ISIN code
            start_pos = position_of("/INS/") + 5
            isin_code = substring(field_72_content, start_pos, 12)
            
            // Lookup security details
            security = reference_data_service.lookup(isin_code)
            
            if (security found) then
              // Format: ISIN + Name
              security_description = "ISIN " + isin_code + "\n" + security.name
            else
              throw error "Security not found in reference data"
            endif
          else
            throw error "No security identifier in field 72"
          endif
          
          return security_description
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATA_EXTRACTION</Type>
          <Expression>contains(source.field_72, '/INS/')</Expression>
          <Action>EXTRACT_ISIN</Action>
          <ElseAction>REJECT with error "Missing security identifier"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>ISIN_VALIDATION</Type>
          <Expression>is_valid_isin_format(extracted_isin)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid ISIN format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>REFERENCE_DATA_LOOKUP</Type>
          <Expression>security_exists_in_reference_data(extracted_isin)</Expression>
          <Action>ENRICH_WITH_DETAILS</Action>
          <ElseAction>LOG_WARNING AND USE_ISIN_ONLY</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>ELIGIBILITY_CHECK</Type>
          <Expression>security_is_eligible_for_settlement(extracted_isin)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Security not eligible for settlement"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Wrong security settled - major operational risk</ImpactIfFails>
        <BusinessRationale>Core identifier for security being transferred</BusinessRationale>
        <PerformanceImpact>HIGH (reference data lookup + enrichment)</PerformanceImpact>
        <CachingStrategy>Cache security details for 1 hour</CachingStrategy>
        <ComplianceNote>Securities must be on approved trading list per MiFID II</ComplianceNote>
      </General>
    </Mapping>
    
    <!-- Mapping 10: Delivering Agent -->
    <Mapping id="MAPPING_10">
      <SourceField ref="FIELD_09"/>
      <TargetField ref="FIELD_10"/>
      
      <MappingFormula>
        <Type>CONDITIONAL_MAPPING</Type>
        <Expression>
          IF source.field_57A != null THEN
            target.field_95P_DEAG = source.field_57A
          ELSE IF source.field_56A != null THEN
            target.field_95P_DEAG = source.field_56A
          ELSE
            target.field_95P_DEAG = get_default_delivering_agent()
          ENDIF
        </Expression>
        <PseudoCode>
          // Use Account With Institution if available
          if (source.field_57A is not null) then
            delivering_agent = source.field_57A
          // Fallback to Intermediary
          else if (source.field_56A is not null) then
            delivering_agent = source.field_56A
          // Default to buyer's custodian
          else
            buyer_bic = already_mapped_buyer
            delivering_agent = lookup_default_custodian(buyer_bic)
          endif
          
          return delivering_agent
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATA_AVAILABILITY</Type>
          <Expression>source.field_57A != null OR source.field_56A != null</Expression>
          <Action>USE_AVAILABLE_FIELD</Action>
          <ElseAction>DERIVE_FROM_BUYER</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BIC_VALIDATION</Type>
          <Expression>is_valid_bic(selected_bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid delivering agent BIC"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>RELATIONSHIP_CHECK</Type>
          <Expression>delivering_agent_has_relationship_with_buyer(agent, buyer)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>LOG_WARNING "Unusual agent-buyer relationship"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>Delivery routing issue - settlement delay</ImpactIfFails>
        <BusinessRationale>Identifies custodian delivering securities</BusinessRationale>
        <PerformanceImpact>MEDIUM (conditional logic + reference lookup)</PerformanceImpact>
        <Note>Optional field but highly recommended for smooth settlement</Note>
      </General>
    </Mapping>
    
    <!-- Mapping 11: Narrative -->
    <Mapping id="MAPPING_11">
      <SourceField ref="FIELD_11"/>
      <TargetField ref="FIELD_11"/>
      
      <MappingFormula>
        <Type>CONCATENATION_WITH_CONTEXT</Type>
        <Expression>
          original_narrative = source.field_72
          reference_link = "LINKED TO PAYMENT " + source.field_20
          target.field_70E_SPRO = concatenate(reference_link, original_narrative)
        </Expression>
        <PseudoCode>
          // Build narrative with payment link
          payment_ref = source.field_20
          original_info = source.field_72
          
          // Format narrative
          narrative = "LINKED TO PAYMENT MT202 REF " + payment_ref
          
          if (original_info is not null) then
            narrative = narrative + "\n" + original_info
          endif
          
          // Truncate if too long
          if (length(narrative) > 350) then
            narrative = substring(narrative, 1, 350)
          endif
          
          return narrative
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>LENGTH_CHECK</Type>
          <Expression>length(formatted_narrative) &lt;= 350</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE to 350 characters</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CONTENT_SANITIZATION</Type>
          <Expression>NOT contains_forbidden_characters(narrative)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REMOVE_FORBIDDEN_CHARS and LOG warning</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>LOW</Criticality>
        <ImpactIfFails>Loss of audit trail but message processable</ImpactIfFails>
        <BusinessRationale>Provides operational context linking payment to settlement</BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
        <AuditValue>HIGH - critical for reconciliation and investigations</AuditValue>
      </General>
    </Mapping>
    
  </FieldMappings>
  
</MessageMapping>
<?xml version="1.0" encoding="UTF-8"?>
<MessageMapping xmlns="http://vermeg.com/banking/mapping" version="1.0">
  
  <!-- ============================================= -->
  <!-- GENERAL INFORMATION -->
  <!-- ============================================= -->
  <GeneralInformation>
    <MappingId>MAP_MT103_PACS008_001</MappingId>
    <MappingName>MT103 to pacs.008 Conversion</MappingName>
    <Version>2.0.0</Version>
    <CreatedDate>2026-02-03</CreatedDate>
    <CreatedBy>Bilel SOUELMI - Vermeg FinTech Team</CreatedBy>
    <LastModifiedDate>2026-02-03</LastModifiedDate>
    <Status>ACTIVE</Status>
    
    <BusinessContext>
      <Description>
        Critical migration from SWIFT MT103 (legacy format) to ISO 20022 pacs.008.001.08 
        (FIToFICustomerCreditTransfer). This is part of the global SWIFT migration initiative 
        where all MT messages will be replaced by MX (ISO 20022) by November 2025.
        
        MT103 is used for single customer credit transfers, while pacs.008 is its ISO 20022 
        equivalent with enhanced structured data, better compliance support, and richer remittance 
        information capabilities.
      </Description>
      
      <UseCases>
        <UseCase>Cross-border customer payments</UseCase>
        <UseCase>Corporate-to-corporate payments</UseCase>
        <UseCase>Salary payments</UseCase>
        <UseCase>Invoice settlements</UseCase>
        <UseCase>Trade finance payments</UseCase>
      </UseCases>
      
      <ApplicableDomains>
        Payments Hub, Treasury Operations, Corporate Banking, Retail Banking, 
        Trade Finance, Compliance, AML Screening
      </ApplicableDomains>
      
      <MigrationContext>
        <Initiative>SWIFT ISO 20022 Migration Program</Initiative>
        <Deadline>November 2025</Deadline>
        <ImpactedBanks>11,000+ financial institutions worldwide</ImpactedBanks>
        <EstimatedVolume>5 billion messages per year</EstimatedVolume>
      </MigrationContext>
    </BusinessContext>
    
    <TechnicalSpecifications>
      <SourceFormat>SWIFT MT103 (ISO 15022)</SourceFormat>
      <TargetFormat>ISO 20022 pacs.008.001.08 (XML)</TargetFormat>
      <ProcessingMode>REAL_TIME</ProcessingMode>
      <AverageProcessingTime>150ms</AverageProcessingTime>
      <MaxProcessingTime>1500ms</MaxProcessingTime>
      <ThroughputCapacity>10000 messages/second</ThroughputCapacity>
    </TechnicalSpecifications>
    
    <ComplianceRequirements>
      <Regulation>EU Sanctions Screening (OFAC, EU Lists)</Regulation>
      <Regulation>AML/CFT - 4th &amp; 5th Directives</Regulation>
      <Regulation>PSD2 - Payment Services Directive</Regulation>
      <Regulation>GDPR - Personal Data Protection</Regulation>
      <Regulation>FATF - Travel Rule Implementation</Regulation>
      <Regulation>SOX - Financial Controls</Regulation>
    </ComplianceRequirements>
    
    <KeyChallenges>
      <Challenge>Structured vs unstructured remittance information</Challenge>
      <Challenge>Enhanced party identification requirements</Challenge>
      <Challenge>Purpose codes mandatory in ISO 20022</Challenge>
      <Challenge>Charge bearer rules more granular</Challenge>
      <Challenge>Address format differences (4x35 vs structured)</Challenge>
    </KeyChallenges>
  </GeneralInformation>
  
  <!-- ============================================= -->
  <!-- SOURCE MESSAGE STRUCTURE (MT103) -->
  <!-- ============================================= -->
  <SourceMessage>
    <MessageType>MT103</MessageType>
    <MessageName>Single Customer Credit Transfer</MessageName>
    <Standard>SWIFT ISO 15022</Standard>
    <Category>Customer Payments</Category>
    
    <Fields>
      
      <!-- Field 1: Sender's Reference -->
      <Field id="FIELD_01">
        <FieldTag>:20:</FieldTag>
        <FieldName>Sender's Reference</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>16</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>ALPHANUMERIC</Format>
        <Description>Unique reference assigned by the sender to unambiguously identify the message</Description>
        <ExampleValue>CORPAY2026020301</ExampleValue>
        <ValidationRules>
          <Rule>Must be unique per sender per day</Rule>
          <Rule>Alphanumeric characters only</Rule>
          <Rule>No special characters except hyphen and underscore</Rule>
        </ValidationRules>
        <BusinessPurpose>Transaction tracking and reconciliation across systems</BusinessPurpose>
      </Field>
      
      <!-- Field 2: Bank Operation Code -->
      <Field id="FIELD_02">
        <FieldTag>:23B:</FieldTag>
        <FieldName>Bank Operation Code</FieldName>
        <DataType>CODE</DataType>
        <MaxLength>4</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>4!c</Format>
        <Description>Type of payment instruction</Description>
        <ExampleValue>CRED</ExampleValue>
        <AllowedValues>
          <Value code="CRED">Credit Transfer</Value>
          <Value code="CRTS">Credit Transfer for Settlement</Value>
          <Value code="SPAY">Salary Payment</Value>
          <Value code="SPRI">Securities Purchase with Cash at Seller</Value>
        </AllowedValues>
        <ValidationRules>
          <Rule>Must be one of the allowed SWIFT codes</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 3: Value Date, Currency, Amount -->
      <Field id="FIELD_03">
        <FieldTag>:32A:</FieldTag>
        <FieldName>Value Date, Currency Code, Interbank Settled Amount</FieldName>
        <DataType>COMPOSITE</DataType>
        <Format>YYMMDD[CCY][AMOUNT]</Format>
        <Mandatory>true</Mandatory>
        <Components>
          <Component name="ValueDate" type="DATE" format="YYMMDD" position="1-6"/>
          <Component name="Currency" type="STRING" format="ISO4217" length="3" position="7-9"/>
          <Component name="Amount" type="DECIMAL" format="15d" position="10+"/>
        </Components>
        <Description>Date, currency and amount of the transaction</Description>
        <ExampleValue>260203EUR25000,00</ExampleValue>
        <ValidationRules>
          <Rule>Date must be valid and not in the past (except for same-day)</Rule>
          <Rule>Currency must be valid ISO 4217 code</Rule>
          <Rule>Amount must be positive and have max 2 decimal places</Rule>
          <Rule>Amount must not exceed 999999999999,99</Rule>
        </ValidationRules>
        <BusinessPurpose>Core financial transaction details</BusinessPurpose>
      </Field>
      
      <!-- Field 4: Ordering Customer -->
      <Field id="FIELD_04">
        <FieldTag>:50K:</FieldTag>
        <FieldName>Ordering Customer (Name &amp; Address)</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>[/Account]CRLF4*35x</Format>
        <Description>Account number and name/address of the ordering customer (payer)</Description>
        <ExampleValue>/FR7630006000011234567890189
SOCIETE GENERALE
PARIS
FRANCE</ExampleValue>
        <ValidationRules>
          <Rule>First line can optionally start with account number preceded by /</Rule>
          <Rule>Maximum 4 lines of 35 characters each for name and address</Rule>
        </ValidationRules>
        <ComplianceNote>Critical for AML/KYC - must contain sufficient identification</ComplianceNote>
      </Field>
      
      <!-- Field 5: Ordering Institution -->
      <Field id="FIELD_05">
        <FieldTag>:52A:</FieldTag>
        <FieldName>Ordering Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>[/Account]CRLF BIC</Format>
        <Mandatory>false</Mandatory>
        <Description>Financial institution of the ordering customer</Description>
        <ExampleValue>SOGEFRPPXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format (8 or 11 characters)</Rule>
          <Rule>BIC must exist in SWIFT BIC Directory</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 6: Sender's Correspondent -->
      <Field id="FIELD_06">
        <FieldTag>:53A:</FieldTag>
        <FieldName>Sender's Correspondent</FieldName>
        <DataType>BIC</DataType>
        <Format>[/Account]CRLF BIC</Format>
        <Mandatory>false</Mandatory>
        <Description>Financial institution through which the sender routes the payment</Description>
        <ExampleValue>BNPAFRPPXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format if provided</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 7: Receiver's Correspondent -->
      <Field id="FIELD_07">
        <FieldTag>:54A:</FieldTag>
        <FieldName>Receiver's Correspondent</FieldName>
        <DataType>BIC</DataType>
        <Format>[/Account]CRLF BIC</Format>
        <Mandatory>false</Mandatory>
        <Description>Financial institution through which the receiver receives the payment</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format if provided</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 8: Intermediary Institution -->
      <Field id="FIELD_08">
        <FieldTag>:56A:</FieldTag>
        <FieldName>Intermediary Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>[/Account]CRLF BIC</Format>
        <Mandatory>false</Mandatory>
        <Description>Financial institution between the sender's and receiver's correspondents</Description>
        <ExampleValue>CHASUS33XXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format if provided</Rule>
        </ValidationRules>
        <BusinessPurpose>Routing instruction for correspondent banking chain</BusinessPurpose>
      </Field>
      
      <!-- Field 9: Account With Institution -->
      <Field id="FIELD_09">
        <FieldTag>:57A:</FieldTag>
        <FieldName>Account With Institution</FieldName>
        <DataType>BIC</DataType>
        <Format>[/Account]CRLF BIC</Format>
        <Mandatory>false</Mandatory>
        <Description>Financial institution where the beneficiary maintains their account</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format if provided</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 10: Beneficiary Customer -->
      <Field id="FIELD_10">
        <FieldTag>:59:</FieldTag>
        <FieldName>Beneficiary Customer</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>[/Account]CRLF4*35x</Format>
        <Description>Account number and name/address of the beneficiary (payee)</Description>
        <ExampleValue>/DE89370400440532013000
DEUTSCHE BANK AG
FRANKFURT AM MAIN
GERMANY</ExampleValue>
        <ValidationRules>
          <Rule>First line can optionally start with account number preceded by /</Rule>
          <Rule>Maximum 4 lines of 35 characters each</Rule>
        </ValidationRules>
        <ComplianceNote>Critical for sanctions screening and beneficiary verification</ComplianceNote>
      </Field>
      
      <!-- Field 11: Remittance Information -->
      <Field id="FIELD_11">
        <FieldTag>:70:</FieldTag>
        <FieldName>Remittance Information</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>4*35x</Format>
        <Description>Details about the purpose of the payment</Description>
        <ExampleValue>INVOICE 2026-0203-001
CONSULTING SERVICES JAN 2026
PAYMENT TERMS NET 30</ExampleValue>
        <ValidationRules>
          <Rule>Maximum 4 lines of 35 characters each</Rule>
          <Rule>Free text format</Rule>
        </ValidationRules>
        <BusinessPurpose>Reconciliation and invoice matching</BusinessPurpose>
      </Field>
      
      <!-- Field 12: Details of Charges -->
      <Field id="FIELD_12">
        <FieldTag>:71A:</FieldTag>
        <FieldName>Details of Charges</FieldName>
        <DataType>CODE</DataType>
        <MaxLength>3</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>3!a</Format>
        <Description>Party responsible for transaction charges</Description>
        <ExampleValue>SHA</ExampleValue>
        <AllowedValues>
          <Value code="OUR">All charges borne by ordering customer</Value>
          <Value code="BEN">All charges borne by beneficiary customer</Value>
          <Value code="SHA">Charges shared - sender pays sender bank, receiver pays receiver bank</Value>
        </AllowedValues>
        <ValidationRules>
          <Rule>Must be one of: OUR, BEN, SHA</Rule>
        </ValidationRules>
        <BusinessNote>SHA is most common for cross-border payments</BusinessNote>
      </Field>
      
      <!-- Field 13: Sender to Receiver Information -->
      <Field id="FIELD_13">
        <FieldTag>:72:</FieldTag>
        <FieldName>Sender to Receiver Information</FieldName>
        <DataType>TEXT</DataType>
        <MaxLength>210</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>6*35x</Format>
        <Description>Additional information for the receiver bank</Description>
        <ExampleValue>/ACC/Additional account information
/BNF/Beneficiary details
/INS/Special instructions</ExampleValue>
        <ValidationRules>
          <Rule>Maximum 6 lines of 35 characters each</Rule>
          <Rule>May contain structured codes (e.g., /ACC/, /BNF/)</Rule>
        </ValidationRules>
        <BusinessPurpose>Operational instructions and compliance information</BusinessPurpose>
      </Field>
      
    </Fields>
  </SourceMessage>
  
  <!-- ============================================= -->
  <!-- TARGET MESSAGE STRUCTURE (pacs.008) -->
  <!-- ============================================= -->
  <TargetMessage>
    <MessageType>pacs.008.001.08</MessageType>
    <MessageName>FIToFICustomerCreditTransfer</MessageName>
    <Standard>ISO 20022</Standard>
    <Schema>pacs.008.001.08.xsd</Schema>
    <Namespace>urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08</Namespace>
    <Category>Customer Payments</Category>
    
    <Fields>
      
      <!-- Field 1: Message Identification -->
      <Field id="FIELD_01">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/MsgId</XPath>
        <FieldName>Message Identification</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>35</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>Max35Text</Format>
        <Description>Unique identification assigned by the instructing party to unambiguously identify the message</Description>
        <ExampleValue>MSGID20260203001234567890</ExampleValue>
        <ISO20022Definition>Point to point reference assigned by the instructing party</ISO20022Definition>
      </Field>
      
      <!-- Field 2: Creation Date Time -->
      <Field id="FIELD_02">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/CreDtTm</XPath>
        <FieldName>Creation Date Time</FieldName>
        <DataType>DATETIME</DataType>
        <Mandatory>true</Mandatory>
        <Format>ISODateTime</Format>
        <Description>Date and time at which the message was created</Description>
        <ExampleValue>2026-02-03T14:30:00Z</ExampleValue>
        <ISO20022Definition>Date and time at which the message was created</ISO20022Definition>
      </Field>
      
      <!-- Field 3: Number of Transactions -->
      <Field id="FIELD_03">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/NbOfTxs</XPath>
        <FieldName>Number of Transactions</FieldName>
        <DataType>INTEGER</DataType>
        <Mandatory>true</Mandatory>
        <Format>Max15NumericText</Format>
        <Description>Number of individual transactions in the message</Description>
        <ExampleValue>1</ExampleValue>
        <ValidationRules>
          <Rule>Must be numeric string</Rule>
          <Rule>For MT103 to pacs.008, always "1" (single transaction)</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 4: Instructed Amount -->
      <Field id="FIELD_04">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Amt/InstdAmt</XPath>
        <FieldName>Instructed Amount</FieldName>
        <DataType>AMOUNT</DataType>
        <Mandatory>true</Mandatory>
        <Format>ActiveOrHistoricCurrencyAndAmount</Format>
        <Attributes>
          <Attribute name="Ccy" type="CurrencyCode" description="Currency code"/>
        </Attributes>
        <Description>Amount of money to be moved between debtor and creditor</Description>
        <ExampleValue Ccy="EUR">25000.00</ExampleValue>
        <ISO20022Definition>Amount of money to be moved between the debtor and creditor, before deduction of charges</ISO20022Definition>
      </Field>
      
      <!-- Field 5: Debtor Name -->
      <Field id="FIELD_05">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Dbtr/Nm</XPath>
        <FieldName>Debtor Name</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>Max140Text</Format>
        <Description>Name by which the debtor is known</Description>
        <ExampleValue>SOCIETE GENERALE</ExampleValue>
        <ISO20022Definition>Name by which a party is known and which is usually used to identify that party</ISO20022Definition>
      </Field>
      
      <!-- Field 6: Debtor Account IBAN -->
      <Field id="FIELD_06">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/DbtrAcct/Id/IBAN</XPath>
        <FieldName>Debtor Account Identification - IBAN</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>34</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>IBAN2007Identifier</Format>
        <Description>International Bank Account Number identifying the debtor account</Description>
        <ExampleValue>FR7630006000011234567890189</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid IBAN format if provided</Rule>
          <Rule>IBAN checksum must be valid</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 7: Debtor Agent BIC -->
      <Field id="FIELD_07">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/DbtrAgt/FinInstnId/BICFI</XPath>
        <FieldName>Debtor Agent - BIC</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>BICFIIdentifier</Format>
        <Description>Bank Identifier Code of the debtor's financial institution</Description>
        <ExampleValue>SOGEFRPPXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format (8 or 11 characters)</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 8: Creditor Agent BIC -->
      <Field id="FIELD_08">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/CdtrAgt/FinInstnId/BICFI</XPath>
        <FieldName>Creditor Agent - BIC</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>BICFIIdentifier</Format>
        <Description>Bank Identifier Code of the creditor's financial institution</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid BIC format</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 9: Creditor Name -->
      <Field id="FIELD_09">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Cdtr/Nm</XPath>
        <FieldName>Creditor Name</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Format>Max140Text</Format>
        <Description>Name by which the creditor is known</Description>
        <ExampleValue>DEUTSCHE BANK AG</ExampleValue>
        <ISO20022Definition>Party to which an amount of money is due</ISO20022Definition>
      </Field>
      
      <!-- Field 10: Creditor Account IBAN -->
      <Field id="FIELD_10">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/CdtrAcct/Id/IBAN</XPath>
        <FieldName>Creditor Account Identification - IBAN</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>34</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>IBAN2007Identifier</Format>
        <Description>International Bank Account Number identifying the creditor account</Description>
        <ExampleValue>DE89370400440532013000</ExampleValue>
        <ValidationRules>
          <Rule>Must be valid IBAN format if provided</Rule>
        </ValidationRules>
      </Field>
      
      <!-- Field 11: Remittance Information Unstructured -->
      <Field id="FIELD_11">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/RmtInf/Ustrd</XPath>
        <FieldName>Remittance Information Unstructured</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>Max140Text</Format>
        <Description>Unstructured remittance information provided by the debtor</Description>
        <ExampleValue>INVOICE 2026-0203-001 CONSULTING SERVICES JAN 2026</ExampleValue>
        <ISO20022Definition>Information supplied to enable the matching/reconciliation of an entry with the items that the payment is intended to settle</ISO20022Definition>
      </Field>
      
      <!-- Field 12: Charge Bearer -->
      <Field id="FIELD_12">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/ChrgBr</XPath>
        <FieldName>Charge Bearer</FieldName>
        <DataType>CODE</DataType>
        <MaxLength>4</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>ChargeBearerType1Code</Format>
        <Description>Specifies which party bears the charges</Description>
        <ExampleValue>SHAR</ExampleValue>
        <AllowedValues>
          <Value code="DEBT">All charges borne by debtor</Value>
          <Value code="CRED">All charges borne by creditor</Value>
          <Value code="SHAR">Charges shared</Value>
          <Value code="SLEV">Service level</Value>
        </AllowedValues>
        <ISO20022Definition>Specifies which party/parties will bear the charges associated with the processing of the payment transaction</ISO20022Definition>
      </Field>
      
      <!-- Field 13: Purpose Code -->
      <Field id="FIELD_13">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Purp/Cd</XPath>
        <FieldName>Purpose Code</FieldName>
        <DataType>CODE</DataType>
        <MaxLength>4</MaxLength>
        <Mandatory>false</Mandatory>
        <Format>ExternalPurpose1Code</Format>
        <Description>Underlying reason for the payment transaction</Description>
        <ExampleValue>SALA</ExampleValue>
        <AllowedValues>
          <Value code="SALA">Salary Payment</Value>
          <Value code="SUPP">Supplier Payment</Value>
          <Value code="TRAD">Trade Settlement</Value>
          <Value code="CASH">Cash Management Transfer</Value>
        </AllowedValues>
        <ISO20022Definition>Specifies the underlying reason of the payment transaction</ISO20022Definition>
        <Note>Not present in MT103 - must be derived or defaulted</Note>
      </Field>
      
    </Fields>
  </TargetMessage>
  
  <!-- ============================================= -->
  <!-- FIELD MAPPINGS -->
  <!-- ============================================= -->
  <FieldMappings>
    
    <!-- Mapping 1: Message Identification -->
    <Mapping id="MAPPING_01">
      <SourceField ref="FIELD_01"/>
      <TargetField ref="FIELD_01"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY_WITH_ENHANCEMENT</Type>
        <Expression>
          base_ref = source.field_20
          timestamp = current_timestamp_compact()
          target.MsgId = base_ref + "_" + timestamp
        </Expression>
        <PseudoCode>
          // Enhance MT103 reference with timestamp for uniqueness
          mt103_reference = source.field_20
          current_time = format_timestamp("YYYYMMDDHHmmss")
          
          // Combine to ensure global uniqueness
          message_id = mt103_reference + "_" + current_time
          
          // Ensure length <= 35 characters
          if (length(message_id) > 35) then
            message_id = substring(message_id, 1, 35)
          endif
          
          return message_id
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_20 != null AND source.field_20 != ""</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing mandatory field 20"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>LENGTH_VALIDATION</Type>
          <Expression>length(source.field_20) &lt;= 16</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Field 20 exceeds maximum length"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>FORMAT_VALIDATION</Type>
          <Expression>matches(source.field_20, "^[A-Za-z0-9\-_]+$")</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Field 20 contains invalid characters"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>UNIQUENESS_CHECK</Type>
          <Expression>NOT exists_in_processed_messages(formatted_msg_id, today)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Duplicate message ID detected"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Message rejected - cannot process without unique identifier</ImpactIfFails>
        <BusinessRationale>
          Ensures end-to-end traceability across MT103 and pacs.008 systems. 
          Critical for payment tracking, reconciliation, and investigations.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE (string concatenation only)</PerformanceImpact>
        <AuditRequirement>All message IDs must be logged for 7 years per regulatory requirements</AuditRequirement>
        <MigrationNote>
          MT103 field 20 is 16 chars max, pacs.008 MsgId is 35 chars max.
          Enhancement with timestamp prevents collisions in high-volume environments.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 2: Creation Date Time -->
    <Mapping id="MAPPING_02">
      <SourceField ref="NONE"/>
      <TargetField ref="FIELD_02"/>
      
      <MappingFormula>
        <Type>SYSTEM_GENERATED</Type>
        <Expression>
          target.CreDtTm = current_datetime_iso8601()
        </Expression>
        <PseudoCode>
          // Generate current timestamp in ISO 8601 format
          current_time = system_current_time()
          iso_formatted = format_datetime(current_time, "YYYY-MM-DDTHH:mm:ssZ")
          return iso_formatted
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>ALWAYS_TRUE</Type>
          <Expression>true</Expression>
          <Action>GENERATE_TIMESTAMP</Action>
          <ElseAction>N/A</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>TIMEZONE_VALIDATION</Type>
          <Expression>is_utc_timezone(generated_timestamp)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>CONVERT_TO_UTC</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>Message rejected by receiving system</ImpactIfFails>
        <BusinessRationale>
          ISO 20022 requires precise timestamp for message creation. 
          Not present in MT103 as it uses SWIFT FIN messaging timestamps.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
        <MigrationNote>
          New mandatory field in ISO 20022. MT103 has no equivalent.
          Must be generated at conversion time using system clock.
        </MigrationNote>
        <TimezonNote>Always use UTC (Z suffix) for consistency across time zones</TimezonNote>
      </General>
    </Mapping>
    
    <!-- Mapping 3: Number of Transactions -->
    <Mapping id="MAPPING_03">
      <SourceField ref="NONE"/>
      <TargetField ref="FIELD_03"/>
      
      <MappingFormula>
        <Type>STATIC_VALUE</Type>
        <Expression>target.NbOfTxs = "1"</Expression>
        <PseudoCode>
          // MT103 is always single transaction
          // pacs.008 can support batch, but for MT103 conversion always 1
          number_of_transactions = "1"
          return number_of_transactions
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>ALWAYS_TRUE</Type>
          <Expression>true</Expression>
          <Action>SET_TO_ONE</Action>
          <ElseAction>N/A</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>Message validation failure</ImpactIfFails>
        <BusinessRationale>
          MT103 represents single customer credit transfer. 
          pacs.008 supports multiple transactions but for MT103 migration always 1.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
        <MigrationNote>
          Always "1" for MT103 to pacs.008 conversion.
          For MT102 (bulk) to pacs.008, this would be count of transactions.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 4: Instructed Amount -->
    <Mapping id="MAPPING_04">
      <SourceField ref="FIELD_03"/>
      <TargetField ref="FIELD_04"/>
      
      <MappingFormula>
        <Type>EXTRACTION_AND_XML_FORMATTING</Type>
        <Expression>
          currency = extract_currency(source.field_32A, position 7-9)
          amount = extract_amount(source.field_32A, position 10+)
          amount_decimal = parse_decimal(amount)
          target.InstdAmt = create_xml_amount(amount_decimal, currency)
        </Expression>
        <PseudoCode>
          // Extract components from composite field 32A
          field_32a = source.field_32A
          
          // Parse: YYMMDD + CCY + AMOUNT
          value_date = substring(field_32a, 1, 6)       // Not used for amount
          currency_code = substring(field_32a, 7, 3)    // EUR, USD, etc.
          amount_string = substring(field_32a, 10)      // 25000,00
          
          // Convert SWIFT format (comma decimal) to ISO format (dot decimal)
          amount_normalized = replace(amount_string, ",", ".")
          amount_decimal = parse_decimal(amount_normalized)
          
          // Create XML element with currency attribute
          xml_amount = {
            "_text": amount_decimal,
            "_attributes": {
              "Ccy": currency_code
            }
          }
          
          return xml_amount
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_32A != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing mandatory field 32A"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>FORMAT_VALIDATION</Type>
          <Expression>matches(source.field_32A, "^\d{6}[A-Z]{3}[\d,]+$")</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid field 32A format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>CURRENCY_VALIDATION</Type>
          <Expression>is_valid_iso4217_currency(extracted_currency)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid currency code"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>AMOUNT_VALIDATION</Type>
          <Expression>extracted_amount > 0 AND extracted_amount &lt; 1000000000000</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Amount out of valid range"</ElseAction>
        </Condition>
        
        <Condition priority="5">
          <Type>DECIMAL_PRECISION_CHECK</Type>
          <Expression>decimal_places(extracted_amount) &lt;= 2</Expression>
          <Action>PROCEED</Action>
          <ElseAction>ROUND to 2 decimal places AND LOG warning</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment cannot be executed - financial loss risk</ImpactIfFails>
        <BusinessRationale>
          Core financial amount that drives the entire payment transaction.
          Any error here results in wrong amount credited to beneficiary.
        </BusinessRationale>
        <PerformanceImpact>LOW (string parsing and decimal conversion)</PerformanceImpact>
        <AccuracyRequirement>
          Amount must be exact to the cent. No rounding errors acceptable.
        </AccuracyRequirement>
        <AuditRequirement>
          All amount conversions must be logged with before/after values per SOX compliance.
        </AuditRequirement>
        <MigrationNote>
          SWIFT uses comma as decimal separator (25000,00).
          ISO 20022 uses dot as decimal separator (25000.00).
          Conversion is critical for accuracy.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 5: Debtor Name -->
    <Mapping id="MAPPING_05">
      <SourceField ref="FIELD_04"/>
      <TargetField ref="FIELD_05"/>
      
      <MappingFormula>
        <Type>TEXT_EXTRACTION_AND_NORMALIZATION</Type>
        <Expression>
          full_field_50k = source.field_50K
          lines = split_lines(full_field_50k)
          
          // First line may have account (optional)
          IF starts_with(lines[0], '/') THEN
            name_lines = lines[1:]
          ELSE
            name_lines = lines
          ENDIF
          
          // Extract just the name (typically first line of name/address)
          debtor_name = name_lines[0]
          target.Dbtr_Nm = trim(debtor_name)
        </Expression>
        <PseudoCode>
          // Field 50K format: [/Account]CRLF Name CRLF Address
          field_50k_content = source.field_50K
          lines = split_by_newline(field_50k_content)
          
          // Check if first line is account number
          if (starts_with(lines[0], "/")) then
            // Account present, skip it
            name_address_lines = lines[1:]
          else
            // No account, all lines are name/address
            name_address_lines = lines
          endif
          
          // Take first line as name (per ISO 20022 best practice)
          debtor_name = name_address_lines[0]
          
          // Clean and normalize
          debtor_name = trim(debtor_name)
          debtor_name = remove_excessive_spaces(debtor_name)
          
          // Validate length
          if (length(debtor_name) > 140) then
            debtor_name = substring(debtor_name, 1, 140)
          endif
          
          return debtor_name
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_50K != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing mandatory field 50K"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CONTENT_VALIDATION</Type>
          <Expression>extracted_name != null AND length(extracted_name) > 0</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Cannot extract debtor name from field 50K"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>LENGTH_VALIDATION</Type>
          <Expression>length(extracted_name) &lt;= 140</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE to 140 characters AND LOG warning</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>SANCTIONS_SCREENING</Type>
          <Expression>NOT is_sanctioned_party(extracted_name)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>BLOCK message AND ALERT compliance team</ElseAction>
        </Condition>
        
        <Condition priority="5">
          <Type>PEP_SCREENING</Type>
          <Expression>NOT is_politically_exposed_person(extracted_name)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>FLAG for enhanced due diligence</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>
          Payment rejected. Compliance violation if sanctions entity not detected.
        </ImpactIfFails>
        <BusinessRationale>
          Identity of the payer (ordering customer). Critical for:
          - AML/KYC compliance
          - Sanctions screening (OFAC, EU, UN lists)
          - PEP (Politically Exposed Person) screening
          - Transaction monitoring and fraud detection
        </BusinessRationale>
        <PerformanceImpact>
          MEDIUM (text parsing + sanctions screening API call)
        </PerformanceImpact>
        <ComplianceRequirement>
          MANDATORY sanctions screening per:
          - OFAC regulations (US)
          - EU Sanctions (Regulation 833/2014)
          - UN Security Council Sanctions
          - 4th &amp; 5th AML Directives (EU)
        </ComplianceRequirement>
        <DataPrivacy>
          Personal name is PII under GDPR. Must be:
          - Encrypted in transit and at rest
          - Access logged for audit
          - Retained per data retention policy (typically 7 years)
          - Right to erasure exceptions apply for compliance records
        </DataPrivacy>
        <MigrationChallenge>
          MT103 field 50K combines account + name + address in free text (4x35 lines).
          ISO 20022 separates these into structured fields (Nm, PstlAdr, etc.).
          Parser must intelligently split the content.
        </MigrationChallenge>
      </General>
    </Mapping>
    
    <!-- Mapping 6: Debtor Account IBAN -->
    <Mapping id="MAPPING_06">
      <SourceField ref="FIELD_04"/>
      <TargetField ref="FIELD_06"/>
      
      <MappingFormula>
        <Type>CONDITIONAL_EXTRACTION_WITH_VALIDATION</Type>
        <Expression>
          full_field_50k = source.field_50K
          lines = split_lines(full_field_50k)
          
          IF starts_with(lines[0], '/') THEN
            account_line = substring(lines[0], 2)  // Remove leading '/'
            IF is_iban_format(account_line) THEN
              target.DbtrAcct_Id_IBAN = account_line
            ELSE
              target.DbtrAcct_Id_Othr = account_line  // Not IBAN
            ENDIF
          ELSE
            // No account number in field 50K
            target.DbtrAcct_Id_IBAN = null
          ENDIF
        </Expression>
        <PseudoCode>
          // Field 50K first line may contain account: /FR7630006000011234567890189
          field_50k_content = source.field_50K
          lines = split_by_newline(field_50k_content)
          first_line = lines[0]
          
          // Check if account number present
          if (starts_with(first_line, "/")) then
            // Extract account (remove leading /)
            account_number = substring(first_line, 2)
            
            // Check if it's IBAN format
            if (matches_iban_pattern(account_number)) then
              // Validate IBAN checksum
              if (is_valid_iban_checksum(account_number)) then
                debtor_iban = account_number
              else
                throw error "Invalid IBAN checksum"
              endif
            else
              // Not IBAN, store in alternative identifier
              debtor_account_other = account_number
              debtor_iban = null
            endif
          else
            // No account in field 50K
            debtor_iban = null
          endif
          
          return debtor_iban
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>FORMAT_DETECTION</Type>
          <Expression>starts_with(first_line, "/")</Expression>
          <Action>EXTRACT_ACCOUNT</Action>
          <ElseAction>SET_TO_NULL (account not provided)</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>IBAN_PATTERN_CHECK</Type>
          <Expression>matches(account, "^[A-Z]{2}\d{2}[A-Z0-9]+$")</Expression>
          <Action>VALIDATE_AS_IBAN</Action>
          <ElseAction>STORE_IN_OTHER_IDENTIFIER</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>IBAN_CHECKSUM_VALIDATION</Type>
          <Expression>iban_checksum_valid(account)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid IBAN checksum"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>COUNTRY_VALIDATION</Type>
          <Expression>iban_country_code_valid(account)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>LOG_WARNING "Unknown IBAN country code"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>
          Payment may still succeed but reconciliation becomes difficult.
          Some jurisdictions require IBAN for regulatory reporting.
        </ImpactIfFails>
        <BusinessRationale>
          Account identification for debiting funds. Essential for:
          - Account reconciliation
          - Automated straight-through processing (STP)
          - Regulatory reporting (e.g., SEPA requires IBAN)
        </BusinessRationale>
        <PerformanceImpact>LOW (pattern matching + checksum calculation)</PerformanceImpact>
        <MigrationChallenge>
          MT103 field 50K optionally contains account in first line with "/" prefix.
          ISO 20022 requires structured account identification:
          - IBAN (preferred for European payments)
          - Other account identifier (for non-IBAN regions)
          
          Parser must:
          1. Detect presence of account
          2. Determine if IBAN or other format
          3. Validate IBAN if applicable
          4. Place in correct XML element
        </MigrationChallenge>
        <RegionalNote>
          - SEPA zone: IBAN mandatory
          - US: Account number in proprietary format
          - Asia: Varies by country
        </RegionalNote>
      </General>
    </Mapping>
    
    <!-- Mapping 7: Debtor Agent BIC -->
    <Mapping id="MAPPING_07">
      <SourceField ref="FIELD_05"/>
      <TargetField ref="FIELD_07"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY_WITH_FALLBACK</Type>
        <Expression>
          IF source.field_52A != null THEN
            target.DbtrAgt_FinInstnId_BICFI = extract_bic(source.field_52A)
          ELSE
            // Fallback: use sender's BIC from message header
            target.DbtrAgt_FinInstnId_BICFI = get_sender_bic_from_header()
          ENDIF
        </Expression>
        <PseudoCode>
          // Field 52A format: [/Account]CRLF BIC
          if (source.field_52A is not null) then
            field_52a = source.field_52A
            lines = split_by_newline(field_52a)
            
            // BIC is on second line if account present, first line otherwise
            if (starts_with(lines[0], "/")) then
              bic_code = lines[1]
            else
              bic_code = lines[0]
            endif
            
            // Validate BIC format
            if (is_valid_bic(bic_code)) then
              debtor_agent_bic = bic_code
            else
              throw error "Invalid BIC format in field 52A"
            endif
          else
            // Field 52A not provided, use sender's BIC
            debtor_agent_bic = message_header.sender_bic
          endif
          
          return debtor_agent_bic
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATA_AVAILABILITY</Type>
          <Expression>source.field_52A != null OR header.sender_bic != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Cannot determine debtor agent"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BIC_FORMAT_VALIDATION</Type>
          <Expression>matches(bic, "^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$")</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid BIC format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>BIC_DIRECTORY_CHECK</Type>
          <Expression>bic_exists_in_swift_directory(bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>LOG_WARNING "BIC not found in SWIFT directory" AND PROCEED</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>SANCTIONS_CHECK</Type>
          <Expression>NOT is_sanctioned_institution(bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>BLOCK AND ALERT</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>Payment routing failure - funds cannot be debited</ImpactIfFails>
        <BusinessRationale>
          Identifies the financial institution that will debit the ordering customer's account.
          Essential for:
          - Payment routing
          - Interbank settlement
          - Compliance and risk management
        </BusinessRationale>
        <PerformanceImpact>LOW (BIC validation + directory lookup)</PerformanceImpact>
        <MigrationNote>
          MT103 field 52A is optional. If not provided, best practice is to use 
          the sender's BIC from SWIFT message header as debtor agent.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 8: Creditor Agent BIC -->
    <Mapping id="MAPPING_08">
      <SourceField ref="FIELD_09"/>
      <TargetField ref="FIELD_08"/>
      
      <MappingFormula>
        <Type>DIRECT_COPY</Type>
        <Expression>
          target.CdtrAgt_FinInstnId_BICFI = extract_bic(source.field_57A)
        </Expression>
        <PseudoCode>
          // Field 57A format: [/Account]CRLF BIC
          field_57a = source.field_57A
          
          if (field_57a is not null) then
            lines = split_by_newline(field_57a)
            
            // BIC is on second line if account present, first line otherwise
            if (starts_with(lines[0], "/")) then
              bic_code = lines[1]
            else
              bic_code = lines[0]
            endif
            
            creditor_agent_bic = validate_and_clean_bic(bic_code)
          else
            creditor_agent_bic = null
          endif
          
          return creditor_agent_bic
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_57A != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing mandatory field 57A"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BIC_VALIDATION</Type>
          <Expression>is_valid_bic_format(extracted_bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid BIC format"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>REACHABILITY_CHECK</Type>
          <Expression>is_reachable_via_swift(extracted_bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Beneficiary bank not reachable"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment cannot be delivered - funds stuck in transit</ImpactIfFails>
        <BusinessRationale>
          Identifies the financial institution that will credit the beneficiary's account.
          Absolutely critical for payment routing and delivery.
        </BusinessRationale>
        <PerformanceImpact>LOW</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 9: Creditor Name -->
    <Mapping id="MAPPING_09">
      <SourceField ref="FIELD_10"/>
      <TargetField ref="FIELD_09"/>
      
      <MappingFormula>
        <Type>TEXT_EXTRACTION_AND_NORMALIZATION</Type>
        <Expression>
          full_field_59 = source.field_59
          lines = split_lines(full_field_59)
          
          IF starts_with(lines[0], '/') THEN
            name_lines = lines[1:]
          ELSE
            name_lines = lines
          ENDIF
          
          creditor_name = name_lines[0]
          target.Cdtr_Nm = trim(creditor_name)
        </Expression>
        <PseudoCode>
          // Same logic as field 50K extraction
          field_59_content = source.field_59
          lines = split_by_newline(field_59_content)
          
          // Skip account line if present
          if (starts_with(lines[0], "/")) then
            name_address_lines = lines[1:]
          else
            name_address_lines = lines
          endif
          
          // Extract name (first line)
          creditor_name = name_address_lines[0]
          creditor_name = trim_and_normalize(creditor_name)
          
          // Validate length
          if (length(creditor_name) > 140) then
            creditor_name = substring(creditor_name, 1, 140)
          endif
          
          return creditor_name
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_59 != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Missing mandatory field 59"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>SANCTIONS_SCREENING</Type>
          <Expression>NOT is_sanctioned_party(extracted_name)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>BLOCK message AND ALERT compliance</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>NAME_MATCHING</Type>
          <Expression>beneficiary_name_matches_account_holder(name, account)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>FLAG for manual review (potential fraud)</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment blocked - compliance violation risk</ImpactIfFails>
        <BusinessRationale>
          Identity of the payee (beneficiary). Critical for:
          - Sanctions screening
          - Fraud detection (name vs account mismatch)
          - Payment reconciliation
        </BusinessRationale>
        <PerformanceImpact>MEDIUM (sanctions screening API)</PerformanceImpact>
        <ComplianceRequirement>
          Mandatory sanctions and PEP screening per AML regulations
        </ComplianceRequirement>
      </General>
    </Mapping>
    
    <!-- Mapping 10: Creditor Account IBAN -->
    <Mapping id="MAPPING_10">
      <SourceField ref="FIELD_10"/>
      <TargetField ref="FIELD_10"/>
      
      <MappingFormula>
        <Type>CONDITIONAL_EXTRACTION_WITH_VALIDATION</Type>
        <Expression>
          // Same logic as debtor account extraction
          full_field_59 = source.field_59
          lines = split_lines(full_field_59)
          
          IF starts_with(lines[0], '/') THEN
            account_line = substring(lines[0], 2)
            IF is_iban_format(account_line) THEN
              target.CdtrAcct_Id_IBAN = account_line
            ELSE
              target.CdtrAcct_Id_Othr = account_line
            ENDIF
          ENDIF
        </Expression>
        <PseudoCode>
          // Identical to Mapping 6 logic but for creditor
          field_59_content = source.field_59
          lines = split_by_newline(field_59_content)
          first_line = lines[0]
          
          if (starts_with(first_line, "/")) then
            account_number = substring(first_line, 2)
            
            if (matches_iban_pattern(account_number) AND 
                is_valid_iban_checksum(account_number)) then
              creditor_iban = account_number
            else
              creditor_account_other = account_number
              creditor_iban = null
            endif
          else
            creditor_iban = null
          endif
          
          return creditor_iban
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>IBAN_VALIDATION</Type>
          <Expression>is_valid_iban(account) OR account is null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid IBAN"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>ACCOUNT_STATUS_CHECK</Type>
          <Expression>is_active_account(account, creditor_agent_bic)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Inactive or closed account"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment credited to wrong account or rejected</ImpactIfFails>
        <BusinessRationale>Destination account for funds crediting</BusinessRationale>
        <PerformanceImpact>MEDIUM (account validation may require API call)</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 11: Remittance Information -->
    <Mapping id="MAPPING_11">
      <SourceField ref="FIELD_11"/>
      <TargetField ref="FIELD_11"/>
      
      <MappingFormula>
        <Type>TEXT_CONCATENATION_WITH_NORMALIZATION</Type>
        <Expression>
          lines = split_lines(source.field_70)
          remittance_text = join(lines, " ")
          remittance_normalized = normalize_whitespace(remittance_text)
          
          IF length(remittance_normalized) > 140 THEN
            target.RmtInf_Ustrd = substring(remittance_normalized, 1, 140)
          ELSE
            target.RmtInf_Ustrd = remittance_normalized
          ENDIF
        </Expression>
        <PseudoCode>
          // Field 70 can have up to 4 lines of 35 chars (140 total)
          field_70_content = source.field_70
          
          if (field_70_content is not null) then
            // Split into lines
            lines = split_by_newline(field_70_content)
            
            // Join with space (ISO 20022 Ustrd is single string)
            remittance_text = join(lines, " ")
            
            // Normalize: remove excess whitespace
            remittance_text = replace_multiple_spaces_with_single(remittance_text)
            remittance_text = trim(remittance_text)
            
            // Validate length
            if (length(remittance_text) > 140) then
              remittance_text = substring(remittance_text, 1, 140)
              log_warning("Remittance information truncated")
            endif
          else
            remittance_text = null
          endif
          
          return remittance_text
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>OPTIONAL_FIELD</Type>
          <Expression>true</Expression>
          <Action>PROCESS if present, skip if null</Action>
          <ElseAction>N/A</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>LENGTH_CHECK</Type>
          <Expression>length(remittance) &lt;= 140</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE and LOG warning</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>CONTENT_SCREENING</Type>
          <Expression>NOT contains_suspicious_keywords(remittance)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>FLAG for compliance review</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>
          Loss of payment purpose information - impacts reconciliation.
          Payment still processable.
        </ImpactIfFails>
        <BusinessRationale>
          Provides context for payment purpose. Critical for:
          - Invoice matching and reconciliation
          - Accounts payable automation
          - Regulatory reporting (some jurisdictions require purpose)
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
        <MigrationNote>
          MT103 field 70 is unstructured (4x35 lines).
          ISO 20022 offers both:
          - Unstructured (Ustrd): Free text like MT103
          - Structured (Strd): Machine-readable references, invoices, etc.
          
          For MT103 migration, typically map to Unstructured.
          Advanced implementations may parse and structure the content.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 12: Charge Bearer -->
    <Mapping id="MAPPING_12">
      <SourceField ref="FIELD_12"/>
      <TargetField ref="FIELD_12"/>
      
      <MappingFormula>
        <Type>CODE_TRANSLATION</Type>
        <Expression>
          mt103_charge_code = source.field_71A
          
          SWITCH mt103_charge_code:
            CASE "OUR": target.ChrgBr = "DEBT"
            CASE "BEN": target.ChrgBr = "CRED"
            CASE "SHA": target.ChrgBr = "SHAR"
            DEFAULT: target.ChrgBr = "SHAR"
          END_SWITCH
        </Expression>
        <PseudoCode>
          // MT103 uses: OUR, BEN, SHA
          // ISO 20022 uses: DEBT, CRED, SHAR, SLEV
          
          mt103_code = source.field_71A
          
          // Code mapping table
          charge_code_map = {
            "OUR": "DEBT",   // Debtor pays all charges
            "BEN": "CRED",   // Creditor pays all charges
            "SHA": "SHAR"    // Shared charges
          }
          
          if (charge_code_map.contains(mt103_code)) then
            iso20022_code = charge_code_map[mt103_code]
          else
            // Default to shared if unknown
            iso20022_code = "SHAR"
            log_warning("Unknown charge code, defaulting to SHAR")
          endif
          
          return iso20022_code
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.field_71A != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>SET_TO_DEFAULT ("SHAR")</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CODE_VALIDATION</Type>
          <Expression>mt103_code IN ["OUR", "BEN", "SHA"]</Expression>
          <Action>PROCEED</Action>
          <ElseAction>LOG_WARNING and USE_DEFAULT</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>REGULATORY_CHECK</Type>
          <Expression>charge_bearer_allowed_for_currency(code, currency)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>OVERRIDE with regulatory requirement</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>
          Incorrect charge allocation - financial impact on sender or receiver
        </ImpactIfFails>
        <BusinessRationale>
          Determines who pays bank charges. Important for:
          - Cost allocation
          - Pricing transparency
          - Regulatory compliance (some regions have rules)
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE (simple code lookup)</PerformanceImpact>
        <RegulatoryNote>
          EU Regulation 924/2009 requires SHA for EUR payments within SEPA.
          Some countries prohibit BEN for consumer protection.
        </RegulatoryNote>
        <MigrationNote>
          Simple 1:1 code translation:
          - MT103 "OUR" → pacs.008 "DEBT"
          - MT103 "BEN" → pacs.008 "CRED"
          - MT103 "SHA" → pacs.008 "SHAR"
          
          ISO 20022 adds "SLEV" (service level) not in MT103.
        </MigrationNote>
      </General>
    </Mapping>
    
    <!-- Mapping 13: Purpose Code -->
    <Mapping id="MAPPING_13">
      <SourceField ref="FIELD_02"/>
      <TargetField ref="FIELD_13"/>
      
      <MappingFormula>
        <Type>DERIVATION_WITH_FALLBACK</Type>
        <Expression>
          bank_operation_code = source.field_23B
          
          // Attempt to derive purpose from bank operation code
          IF bank_operation_code == "SPAY" THEN
            target.Purp_Cd = "SALA"  // Salary payment
          ELSE IF bank_operation_code == "CRED" THEN
            // Analyze remittance info for hints
            IF contains(source.field_70, "INVOICE") THEN
              target.Purp_Cd = "SUPP"  // Supplier payment
            ELSE IF contains(source.field_70, "SALARY") THEN
              target.Purp_Cd = "SALA"
            ELSE
              target.Purp_Cd = "GDDS"  // Goods (default for credit transfer)
            ENDIF
          ELSE
            target.Purp_Cd = "OTHR"  // Other
          ENDIF
        </Expression>
        <PseudoCode>
          // ISO 20022 encourages Purpose Code but MT103 doesn't have it
          // Must derive intelligently from available fields
          
          bank_op_code = source.field_23B
          remittance = source.field_70
          
          // Primary derivation from field 23B
          if (bank_op_code == "SPAY") then
            purpose_code = "SALA"  // Salary payment
          else if (bank_op_code == "CRED") then
            // Secondary derivation from remittance keywords
            remittance_lower = to_lowercase(remittance)
            
            if (contains(remittance_lower, "invoice") OR 
                contains(remittance_lower, "inv")) then
              purpose_code = "SUPP"  // Supplier/Invoice payment
            else if (contains(remittance_lower, "salary") OR 
                     contains(remittance_lower, "payroll")) then
              purpose_code = "SALA"  // Salary
            else if (contains(remittance_lower, "loan") OR 
                     contains(remittance_lower, "credit")) then
              purpose_code = "LOAN"  // Loan repayment
            else if (contains(remittance_lower, "rent")) then
              purpose_code = "RENT"  // Rent payment
            else
              purpose_code = "GDDS"  // Goods/Services (generic)
            endif
          else if (bank_op_code == "CRTS") then
            purpose_code = "TRAD"  // Trade settlement
          else
            purpose_code = "OTHR"  // Other/Unknown
          endif
          
          return purpose_code
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>CODE_DERIVATION</Type>
          <Expression>bank_operation_code != null</Expression>
          <Action>ATTEMPT_DERIVATION</Action>
          <ElseAction>USE_DEFAULT ("OTHR")</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>REGULATORY_REQUIREMENT</Type>
          <Expression>purpose_code_required_for_destination_country(creditor_country)</Expression>
          <Action>ENSURE_PURPOSE_SET</Action>
          <ElseAction>OPTIONAL - may leave empty</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>CONFIDENCE_CHECK</Type>
          <Expression>derivation_confidence > 0.7</Expression>
          <Action>USE_DERIVED_CODE</Action>
          <ElseAction>USE_GENERIC_CODE ("OTHR") and LOG for manual review</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>
          Some countries/banks may reject if purpose code mandatory and missing.
          Otherwise, payment proceeds with less context.
        </ImpactIfFails>
        <BusinessRationale>
          Purpose codes enable:
          - Statistical reporting (central banks)
          - Regulatory compliance (capital controls, reporting)
          - Automated processing rules
          - Tax reporting
        </BusinessRationale>
        <PerformanceImpact>LOW (text search in remittance field)</PerformanceImpact>
        <MigrationChallenge>
          **MAJOR CHALLENGE**: Purpose Code does not exist in MT103.
          Must be derived using heuristics from:
          - Field 23B (Bank Operation Code): limited hints
          - Field 70 (Remittance Info): keyword analysis
          - External data: customer type, historical patterns
          
          Accuracy varies (60-80% typically).
          Some banks require manual classification or customer input.
        </MigrationChallenge>
        <RegionalRequirements>
          - China: Mandatory purpose code for cross-border payments
          - India: Required for certain transaction types
          - Russia: Purpose required for regulatory reporting
          - EU/US: Optional but recommended for STP
        </RegionalRequirements>
        <RecommendedApproach>
          1. Use ML model trained on historical data for better accuracy
          2. Allow manual override/enrichment
          3. Maintain fallback to generic codes
          4. Log confidence score for audit
        </RecommendedApproach>
      </General>
    </Mapping>
    
  </FieldMappings>
  
  <!-- ============================================= -->
  <!-- VALIDATION RULES -->
  <!-- ============================================= -->
  <ValidationRules>
    <PreConversionRules>
      <Rule id="PRE_001" type="MANDATORY_FIELDS">
        <Description>Validate all mandatory MT103 fields are present</Description>
        <Fields>field_20, field_23B, field_32A, field_50K, field_59, field_71A</Fields>
        <Action>REJECT if any mandatory field missing</Action>
      </Rule>
      
      <Rule id="PRE_002" type="AMOUNT_VALIDATION">
        <Description>Amount must be within acceptable range</Description>
        <Condition>amount > 0 AND amount &lt; 1000000000</Condition>
        <Action>REJECT if out of range</Action>
      </Rule>
      
      <Rule id="PRE_003" type="CURRENCY_CHECK">
        <Description>Currency must be supported</Description>
        <Condition>currency IN supported_currencies_list</Condition>
        <Action>REJECT if unsupported currency</Action>
      </Rule>
      
      <Rule id="PRE_004" type="SANCTIONS_PRE_SCREEN">
        <Description>Pre-screen parties against sanctions lists</Description>
        <Parties>debtor_name, creditor_name, debtor_agent, creditor_agent</Parties>
        <Action>BLOCK if any party is sanctioned</Action>
      </Rule>
    </PreConversionRules>
    
    <PostConversionRules>
      <Rule id="POST_001" type="SCHEMA_VALIDATION">
        <Description>Validate generated XML against pacs.008.001.08 XSD schema</Description>
        <Schema>pacs.008.001.08.xsd</Schema>
        <Action>REJECT if schema validation fails</Action>
      </Rule>
      
      <Rule id="POST_002" type="BUSINESS_RULE_VALIDATION">
        <Description>Validate ISO 20022 business rules</Description>
        <Rules>
          <Rule>Number of transactions matches actual credit transfer count</Rule>
          <Rule>Control sum matches sum of individual amounts</Rule>
          <Rule>All BICs are reachable via SWIFT network</Rule>
        </Rules>
        <Action>REJECT if business rules violated</Action>
      </Rule>
      
      <Rule id="POST_003" type="COMPLETENESS_CHECK">
        <Description>Ensure no critical data lost in conversion</Description>
        <Action>LOG WARNING if optional but important fields are empty</Action>
      </Rule>
    </PostConversionRules>
  </ValidationRules>
  
  <!-- ============================================= -->
  <!-- ERROR HANDLING -->
  <!-- ============================================= -->
  <ErrorHandling>
    <ErrorCategories>
      <Category name="MAPPING_ERROR" severity="ERROR" action="REJECT">
        <Description>Field mapping failed due to data format issues</Description>
        <RecoveryAction>MANUAL_INTERVENTION_REQUIRED</RecoveryAction>
      </Category>
      
      <Category name="VALIDATION_ERROR" severity="ERROR" action="REJECT">
        <Description>Validation rule violation</Description>
        <RecoveryAction>FIX_SOURCE_DATA_AND_RESUBMIT</RecoveryAction>
      </Category>
      
      <Category name="SANCTIONS_HIT" severity="CRITICAL" action="BLOCK">
        <Description>Sanctions screening match detected</Description>
        <RecoveryAction>COMPLIANCE_REVIEW_REQUIRED</RecoveryAction>
        <Notification>IMMEDIATE_ALERT_TO_COMPLIANCE_OFFICER</Notification>
      </Category>
      
      <Category name="ENRICHMENT_FAILURE" severity="WARNING" action="PROCEED_WITH_DEFAULT">
        <Description>Optional data enrichment failed (e.g., purpose code derivation)</Description>
        <RecoveryAction>USE_DEFAULT_VALUE_AND_LOG</RecoveryAction>
      </Category>
      
      <Category name="SCHEMA_VIOLATION" severity="ERROR" action="REJECT">
        <Description>Generated XML does not comply with ISO 20022 schema</Description>
        <RecoveryAction>FIX_MAPPING_LOGIC</RecoveryAction>
      </Category>
    </ErrorCategories>
    
    <RecoveryMechanisms>
      <Mechanism type="RETRY" applies_to="TRANSIENT_ERRORS">
        <MaxAttempts>3</MaxAttempts>
        <BackoffStrategy>EXPONENTIAL</BackoffStrategy>
        <InitialDelay>1000ms</InitialDelay>
        <MaxDelay>10000ms</MaxDelay>
        <RetryableConditions>
          <Condition>SERVICE_TIMEOUT</Condition>
          <Condition>NETWORK_ERROR</Condition>
          <Condition>DATABASE_UNAVAILABLE</Condition>
        </RetryableConditions>
      </Mechanism>
      
      <Mechanism type="FALLBACK" applies_to="DATA_ENRICHMENT">
        <FallbackSequence>
          <Step order="1">Try primary reference data service</Step>
          <Step order="2">Try cached data</Step>
          <Step order="3">Use default values</Step>
        </FallbackSequence>
      </Mechanism>
      
      <Mechanism type="MANUAL_QUEUE" applies_to="UNRESOLVABLE_ERRORS">
        <Description>Route to manual processing queue for human intervention</Description>
        <QueuePriority>HIGH for sanctions hits, NORMAL for mapping issues</QueuePriority>
        <SLA>4 hours for HIGH, 24 hours for NORMAL</SLA>
      </Mechanism>
    </RecoveryMechanisms>
    
    <NotificationRules>
      <Notify event="SANCTIONS_HIT" recipients="COMPLIANCE_TEAM" channel="EMAIL_SMS_PAGERDUTY" priority="CRITICAL"/>
      <Notify event="HIGH_VALUE_FAILURE" recipients="OPS_MANAGER" channel="EMAIL" priority="HIGH"/>
      <Notify event="SCHEMA_VIOLATION" recipients="TECH_TEAM" channel="SLACK" priority="MEDIUM"/>
      <Notify event="ENRICHMENT_FAILURE" recipients="DATA_QUALITY_TEAM" channel="EMAIL" priority="LOW"/>
    </NotificationRules>
  </ErrorHandling>
  
  <!-- ============================================= -->
  <!-- PERFORMANCE &amp; MONITORING -->
  <!-- ============================================= -->
  <PerformanceMetrics>
    <SLA>
      <ConversionTime target="150ms" max="1500ms" percentile="99"/>
      <SuccessRate target="99.95%" measurement="DAILY"/>
      <Throughput target="10000 messages/second" peak="15000 messages/second"/>
      <StraightThroughProcessing target="95%" description="Percentage processed without manual intervention"/>
    </SLA>
    
    <Monitoring>
      <Metric name="conversion_duration_ms" type="HISTOGRAM"/>
      <Metric name="conversion_success_rate" type="GAUGE"/>
      <Metric name="sanctions_screening_duration_ms" type="HISTOGRAM"/>
      <Metric name="purpose_code_derivation_accuracy" type="GAUGE"/>
      <Metric name="schema_validation_failures" type="COUNTER"/>
      <Metric name="manual_queue_size" type="GAUGE"/>
      
      <Alert condition="conversion_duration_ms > 1500" severity="WARNING"/>
      <Alert condition="conversion_success_rate < 0.9995" severity="CRITICAL"/>
      <Alert condition="manual_queue_size > 100" severity="HIGH"/>
      <Alert condition="sanctions_screening_duration_ms > 5000" severity="WARNING" description="Sanctions API slow"/>
    </Monitoring>
    
    <PerformanceOptimizations>
      <Optimization name="BIC_CACHE">
        <Description>Cache BIC directory lookups for 24 hours</Description>
        <ImpactEstimate>50ms saving per message</ImpactEstimate>
      </Optimization>
      
      <Optimization name="SANCTIONS_BULK_CHECK">
        <Description>Batch sanctions checks every 100ms instead of per-message</Description>
        <ImpactEstimate>30% throughput improvement</ImpactEstimate>
      </Optimization>
      
      <Optimization name="PARALLEL_VALIDATION">
        <Description>Run pre and post validation rules in parallel</Description>
        <ImpactEstimate>20ms saving per message</ImpactEstimate>
      </Optimization>
    </PerformanceOptimizations>
  </PerformanceMetrics>
  
  <!-- ============================================= -->
  <!-- AUDIT &amp; COMPLIANCE -->
  <!-- ============================================= -->
  <AuditConfiguration>
    <LoggingPolicy>
      <LogLevel>INFO</LogLevel>
      <LogFields>
        message_id, mt103_reference, conversion_status, timestamp, user_id,
        debtor_name, creditor_name, amount, currency, purpose_code_derived,
        sanctions_check_result, validation_errors
      </LogFields>
      <RetentionPeriod>7_YEARS</RetentionPeriod>
      <EncryptionRequired>TRUE</EncryptionRequired>
    </LoggingPolicy>
    
    <ComplianceRequirements>
      <Requirement regulation="PSD2">
        <Mandate>Strong customer authentication for electronic payments</Mandate>
        <Implementation>Verify authentication token in message header</Implementation>
      </Requirement>
      
      <Requirement regulation="AML_4th_5th_Directive">
        <Mandate>Customer due diligence and transaction monitoring</Mandate>
        <Implementation>
          - Sanctions screening (real-time)
          - PEP screening (real-time)
          - Transaction monitoring (post-processing)
          - Record keeping (7 years)
        </Implementation>
      </Requirement>
      
      <Requirement regulation="FATF_Travel_Rule">
        <Mandate>Include originator and beneficiary information</Mandate>
        <Implementation>Ensure fields 50K and 59 contain sufficient identification</Implementation>
      </Requirement>
      
      <Requirement regulation="GDPR">
        <Mandate>Personal data protection</Mandate>
        <Implementation>
          - Encrypt PII in logs and storage
          - Implement right to erasure (with exceptions for compliance data)
          - Data minimization (only collect necessary fields)
          - Access logging for all PII access
        </Implementation>
      </Requirement>
      
      <Requirement regulation="SWIFT_CSP">
        <Mandate>SWIFT Customer Security Programme compliance</Mandate>
        <Implementation>
          - Secure message storage
          - Access controls and segregation
          - Security monitoring
          - Incident response procedures
        </Implementation>
      </Requirement>
    </ComplianceRequirements>
    
    <DataPrivacy>
      <PIIFields>
        <Field>Debtor Name</Field>
        <Field>Debtor Address</Field>
        <Field>Debtor Account</Field>
        <Field>Creditor Name</Field>
        <Field>Creditor Address</Field>
        <Field>Creditor Account</Field>
        <Field>Remittance Information (may contain personal references)</Field>
      </PIIFields>
      
      <ProtectionMeasures>
        <Measure>Encryption at rest (AES-256)</Measure>
        <Measure>Encryption in transit (TLS 1.3)</Measure>
        <Measure>Access logging and monitoring</Measure>
        <Measure>Data minimization - only store necessary fields</Measure>
        <Measure>Pseudonymization for analytics and reporting</Measure>
      </ProtectionMeasures>
      
      <RetentionPolicy>
        <TransactionalData>7 years (regulatory requirement)</TransactionalData>
        <AuditLogs>10 years (best practice)</AuditLogs>
        <ComplianceRecords>Indefinite (sanctions hits, investigations)</ComplianceRecords>
      </RetentionPolicy>
    </DataPrivacy>
  </AuditConfiguration>
  
</MessageMapping>
<?xml version="1.0" encoding="UTF-8"?>
<MessageMapping xmlns="http://vermeg.com/banking/mapping" version="1.0">
  
  <!-- ============================================= -->
  <!-- GENERAL INFORMATION -->
  <!-- ============================================= -->
  <GeneralInformation>
    <MappingId>MAP_PACS008_CORE_001</MappingId>
    <MappingName>pacs.008 to Core Banking System Conversion</MappingName>
    <Version>2.0.0</Version>
    <CreatedDate>2026-02-03</CreatedDate>
    <CreatedBy>Bilel SOUELMI - Vermeg FinTech Team</CreatedBy>
    <LastModifiedDate>2026-02-03</LastModifiedDate>
    <Status>ACTIVE</Status>
    
    <BusinessContext>
      <Description>
        Converts ISO 20022 pacs.008.001.08 (FIToFICustomerCreditTransfer) messages into
        Core Banking System transactions for account posting. This is the final step in the
        payment processing chain where the payment instruction is translated into actual
        debit/credit entries in customer and internal bank accounts.
        
        pacs.008 represents interbank credit transfers. When a bank receives such a message,
        it must:
        1. Credit the beneficiary customer's account (if account held locally)
        2. Update nostro/vostro accounts for interbank settlement
        3. Post to General Ledger (GL) for accounting
        4. Generate account statements
        5. Update balances and transaction history
        
        This mapping bridges the gap between the standardized ISO 20022 messaging layer
        and proprietary Core Banking systems (e.g., Temenos T24, Oracle FLEXCUBE, 
        Finastra Equation, Mambu, Thought Machine Vault).
      </Description>
      
      <UseCases>
        <UseCase>Incoming international payment - credit customer account</UseCase>
        <UseCase>Interbank settlement - nostro account reconciliation</UseCase>
        <UseCase>Real-time gross settlement (RTGS) posting</UseCase>
        <UseCase>SEPA credit transfer posting</UseCase>
        <UseCase>Cross-border remittance crediting</UseCase>
        <UseCase>Corporate bulk payment file processing</UseCase>
      </UseCases>
      
      <ApplicableDomains>
        Core Banking, Account Management, General Ledger, Nostro Reconciliation,
        Customer Accounts, Payment Operations, Real-time Payments
      </ApplicableDomains>
      
      <IntegrationContext>
        <Systems>
          <System name="Temenos_T24" api="TAFJ/jBASE" protocol="REST/SOAP"/>
          <System name="Oracle_FLEXCUBE" api="FCUBS" protocol="REST/SOAP"/>
          <System name="Finastra_Equation" api="Equation_API" protocol="REST"/>
          <System name="Mambu" api="REST_API" protocol="REST"/>
          <System name="FIS_Systematics" api="Systematics_API" protocol="MQ/REST"/>
        </Systems>
      </IntegrationContext>
    </BusinessContext>
    
    <TechnicalSpecifications>
      <SourceFormat>ISO 20022 pacs.008.001.08 (XML)</SourceFormat>
      <TargetFormat>Core Banking Transaction JSON/API</TargetFormat>
      <ProcessingMode>REAL_TIME</ProcessingMode>
      <AverageProcessingTime>250ms</AverageProcessingTime>
      <MaxProcessingTime>3000ms</MaxProcessingTime>
      <ThroughputCapacity>5000 transactions/second</ThroughputCapacity>
      <DatabaseTransactions>ACID compliant with rollback capability</DatabaseTransactions>
    </TechnicalSpecifications>
    
    <ComplianceRequirements>
      <Regulation>Basel III - Liquidity Coverage Ratio (LCR)</Regulation>
      <Regulation>IFRS 9 - Financial Instruments Accounting</Regulation>
      <Regulation>Local Central Bank Reporting Requirements</Regulation>
      <Regulation>AML Transaction Monitoring</Regulation>
      <Regulation>GDPR - Customer Data Protection</Regulation>
      <Regulation>Sarbanes-Oxley (SOX) - Financial Controls</Regulation>
    </ComplianceRequirements>
    
    <KeyChallenges>
      <Challenge>ISO 20022 message to multiple core banking tables/APIs</Challenge>
      <Challenge>Account validation in real-time</Challenge>
      <Challenge>Balance checking and overdraft rules</Challenge>
      <Challenge>Currency conversion for multi-currency accounts</Challenge>
      <Challenge>Fee calculation and posting</Challenge>
      <Challenge>GL posting rules and accounting entries</Challenge>
      <Challenge>Duplicate payment detection</Challenge>
      <Challenge>Transaction rollback on failure</Challenge>
      <Challenge>Real-time balance updates and locks</Challenge>
    </KeyChallenges>
  </GeneralInformation>
  
  <!-- ============================================= -->
  <!-- SOURCE MESSAGE STRUCTURE (pacs.008) -->
  <!-- ============================================= -->
  <SourceMessage>
    <MessageType>pacs.008.001.08</MessageType>
    <MessageName>FIToFICustomerCreditTransfer</MessageName>
    <Standard>ISO 20022</Standard>
    <Schema>pacs.008.001.08.xsd</Schema>
    <Namespace>urn:iso:std:iso:20022:tech:xsd:pacs.008.001.08</Namespace>
    <Category>Interbank Customer Payments</Category>
    
    <Fields>
      
      <!-- Field 1: Message Identification -->
      <Field id="FIELD_01">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/MsgId</XPath>
        <FieldName>Message Identification</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>35</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Unique message identifier</Description>
        <ExampleValue>PACS20260203ABC123456789</ExampleValue>
      </Field>
      
      <!-- Field 2: Creation Date Time -->
      <Field id="FIELD_02">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/CreDtTm</XPath>
        <FieldName>Creation Date Time</FieldName>
        <DataType>DATETIME</DataType>
        <Mandatory>true</Mandatory>
        <Description>Message creation timestamp</Description>
        <ExampleValue>2026-02-03T14:35:22Z</ExampleValue>
      </Field>
      
      <!-- Field 3: Instructing Agent BIC -->
      <Field id="FIELD_03">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/InstgAgt/FinInstnId/BICFI</XPath>
        <FieldName>Instructing Agent</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>BIC of instructing bank</Description>
        <ExampleValue>SOGEFRPPXXX</ExampleValue>
      </Field>
      
      <!-- Field 4: Instructed Agent BIC -->
      <Field id="FIELD_04">
        <XPath>/Document/FIToFICstmrCdtTrf/GrpHdr/InstdAgt/FinInstnId/BICFI</XPath>
        <FieldName>Instructed Agent</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>BIC of instructed bank (us)</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
      </Field>
      
      <!-- Field 5: End-to-End Identification -->
      <Field id="FIELD_05">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/PmtId/EndToEndId</XPath>
        <FieldName>End to End Identification</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>35</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Unique end-to-end transaction reference</Description>
        <ExampleValue>E2E-CORP-2026-02-03-001</ExampleValue>
      </Field>
      
      <!-- Field 6: Transaction Identification -->
      <Field id="FIELD_06">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/PmtId/TxId</XPath>
        <FieldName>Transaction Identification</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>35</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Unique transaction identifier</Description>
        <ExampleValue>TXN-20260203-ABC-001</ExampleValue>
      </Field>
      
      <!-- Field 7: Interbank Settlement Amount -->
      <Field id="FIELD_07">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/IntrBkSttlmAmt</XPath>
        <FieldName>Interbank Settlement Amount</FieldName>
        <DataType>AMOUNT</DataType>
        <Mandatory>true</Mandatory>
        <Attributes>
          <Attribute name="Ccy" type="CurrencyCode"/>
        </Attributes>
        <Description>Amount settled between banks</Description>
        <ExampleValue Ccy="EUR">25000.00</ExampleValue>
      </Field>
      
      <!-- Field 8: Instructed Amount -->
      <Field id="FIELD_08">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Amt/InstdAmt</XPath>
        <FieldName>Instructed Amount</FieldName>
        <DataType>AMOUNT</DataType>
        <Mandatory>false</Mandatory>
        <Attributes>
          <Attribute name="Ccy" type="CurrencyCode"/>
        </Attributes>
        <Description>Original instructed amount (before charges)</Description>
        <ExampleValue Ccy="EUR">25000.00</ExampleValue>
      </Field>
      
      <!-- Field 9: Value Date -->
      <Field id="FIELD_09">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/IntrBkSttlmDt</XPath>
        <FieldName>Interbank Settlement Date</FieldName>
        <DataType>DATE</DataType>
        <Mandatory>true</Mandatory>
        <Description>Date of settlement</Description>
        <ExampleValue>2026-02-03</ExampleValue>
      </Field>
      
      <!-- Field 10: Charge Bearer -->
      <Field id="FIELD_10">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/ChrgBr</XPath>
        <FieldName>Charge Bearer</FieldName>
        <DataType>CODE</DataType>
        <Mandatory>false</Mandatory>
        <Description>Who pays the charges</Description>
        <ExampleValue>SHAR</ExampleValue>
      </Field>
      
      <!-- Field 11: Debtor Name -->
      <Field id="FIELD_11">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Dbtr/Nm</XPath>
        <FieldName>Debtor Name</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Name of the payer</Description>
        <ExampleValue>ACME CORPORATION</ExampleValue>
      </Field>
      
      <!-- Field 12: Debtor Account IBAN -->
      <Field id="FIELD_12">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/DbtrAcct/Id/IBAN</XPath>
        <FieldName>Debtor Account</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>34</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payer's account number</Description>
        <ExampleValue>FR7630004000031234567890143</ExampleValue>
      </Field>
      
      <!-- Field 13: Debtor Agent BIC -->
      <Field id="FIELD_13">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/DbtrAgt/FinInstnId/BICFI</XPath>
        <FieldName>Debtor Agent</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payer's bank BIC</Description>
        <ExampleValue>SOGEFRPPXXX</ExampleValue>
      </Field>
      
      <!-- Field 14: Creditor Name -->
      <Field id="FIELD_14">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Cdtr/Nm</XPath>
        <FieldName>Creditor Name</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>true</Mandatory>
        <Description>Name of the payee</Description>
        <ExampleValue>JOHN DOE</ExampleValue>
      </Field>
      
      <!-- Field 15: Creditor Account IBAN -->
      <Field id="FIELD_15">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/CdtrAcct/Id/IBAN</XPath>
        <FieldName>Creditor Account</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>34</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payee's account number</Description>
        <ExampleValue>DE89370400440532013000</ExampleValue>
      </Field>
      
      <!-- Field 16: Creditor Agent BIC -->
      <Field id="FIELD_16">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/CdtrAgt/FinInstnId/BICFI</XPath>
        <FieldName>Creditor Agent</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>11</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payee's bank BIC</Description>
        <ExampleValue>DEUTDEFFXXX</ExampleValue>
      </Field>
      
      <!-- Field 17: Remittance Information -->
      <Field id="FIELD_17">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/RmtInf/Ustrd</XPath>
        <FieldName>Remittance Information</FieldName>
        <DataType>STRING</DataType>
        <MaxLength>140</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payment purpose/details</Description>
        <ExampleValue>Invoice 2026-001 Payment</ExampleValue>
      </Field>
      
      <!-- Field 18: Purpose Code -->
      <Field id="FIELD_18">
        <XPath>/Document/FIToFICstmrCdtTrf/CdtTrfTxInf/Purp/Cd</XPath>
        <FieldName>Purpose Code</FieldName>
        <DataType>CODE</DataType>
        <MaxLength>4</MaxLength>
        <Mandatory>false</Mandatory>
        <Description>Payment purpose category</Description>
        <ExampleValue>SUPP</ExampleValue>
      </Field>
      
    </Fields>
  </SourceMessage>
  
  <!-- ============================================= -->
  <!-- TARGET SYSTEM STRUCTURE (Core Banking) -->
  <!-- ============================================= -->
  <TargetSystem>
    <SystemName>Core Banking System</SystemName>
    <SystemType>Universal Banking Platform</SystemType>
    <DataFormat>JSON/REST API</DataFormat>
    <TransactionModel>Double-Entry Accounting</TransactionModel>
    
    <Entities>
      
      <!-- Entity 1: Account Transaction -->
      <Entity id="ENTITY_01">
        <EntityName>AccountTransaction</EntityName>
        <EntityType>CREDIT_TRANSACTION</EntityType>
        <APIEndpoint>POST /api/v1/accounts/{account_id}/transactions</APIEndpoint>
        <Description>Main transaction record for customer account posting</Description>
        
        <Fields>
          <Field name="transaction_id" type="STRING" maxLength="35" mandatory="true" description="Unique transaction ID"/>
          <Field name="account_number" type="STRING" maxLength="34" mandatory="true" description="Account to credit/debit"/>
          <Field name="transaction_type" type="CODE" mandatory="true" description="CREDIT or DEBIT"/>
          <Field name="amount" type="DECIMAL" precision="15,2" mandatory="true" description="Transaction amount"/>
          <Field name="currency" type="STRING" length="3" mandatory="true" description="ISO 4217 currency code"/>
          <Field name="value_date" type="DATE" mandatory="true" description="Value date"/>
          <Field name="booking_date" type="DATE" mandatory="true" description="Booking date"/>
          <Field name="description" type="STRING" maxLength="140" mandatory="false" description="Transaction description"/>
          <Field name="reference" type="STRING" maxLength="35" mandatory="true" description="External reference"/>
          <Field name="originator_name" type="STRING" maxLength="140" mandatory="false" description="Payer name"/>
          <Field name="originator_account" type="STRING" maxLength="34" mandatory="false" description="Payer account"/>
          <Field name="status" type="CODE" mandatory="true" description="PENDING, POSTED, FAILED"/>
        </Fields>
        
        <ExamplePayload>
{
  "transaction_id": "TXN-20260203-ABC-001",
  "account_number": "DE89370400440532013000",
  "transaction_type": "CREDIT",
  "amount": 25000.00,
  "currency": "EUR",
  "value_date": "2026-02-03",
  "booking_date": "2026-02-03",
  "description": "Invoice 2026-001 Payment",
  "reference": "E2E-CORP-2026-02-03-001",
  "originator_name": "ACME CORPORATION",
  "originator_account": "FR7630004000031234567890143",
  "status": "PENDING"
}
        </ExamplePayload>
      </Entity>
      
      <!-- Entity 2: GL Posting -->
      <Entity id="ENTITY_02">
        <EntityName>GeneralLedgerEntry</EntityName>
        <EntityType>ACCOUNTING_ENTRY</EntityType>
        <APIEndpoint>POST /api/v1/gl/entries</APIEndpoint>
        <Description>Double-entry accounting records</Description>
        
        <Fields>
          <Field name="entry_id" type="STRING" mandatory="true"/>
          <Field name="transaction_id" type="STRING" mandatory="true"/>
          <Field name="gl_account" type="STRING" mandatory="true" description="GL account code"/>
          <Field name="debit_amount" type="DECIMAL" mandatory="false"/>
          <Field name="credit_amount" type="DECIMAL" mandatory="false"/>
          <Field name="currency" type="STRING" mandatory="true"/>
          <Field name="value_date" type="DATE" mandatory="true"/>
          <Field name="description" type="STRING" mandatory="false"/>
        </Fields>
      </Entity>
      
      <!-- Entity 3: Nostro Account -->
      <Entity id="ENTITY_03">
        <EntityName>NostroAccountEntry</EntityName>
        <EntityType>NOSTRO_RECONCILIATION</EntityType>
        <APIEndpoint>POST /api/v1/nostro/entries</APIEndpoint>
        <Description>Nostro account entries for interbank settlement</Description>
        
        <Fields>
          <Field name="nostro_account_id" type="STRING" mandatory="true"/>
          <Field name="correspondent_bank_bic" type="STRING" mandatory="true"/>
          <Field name="transaction_type" type="CODE" mandatory="true"/>
          <Field name="amount" type="DECIMAL" mandatory="true"/>
          <Field name="currency" type="STRING" mandatory="true"/>
          <Field name="value_date" type="DATE" mandatory="true"/>
          <Field name="reference" type="STRING" mandatory="true"/>
          <Field name="reconciliation_status" type="CODE" mandatory="true"/>
        </Fields>
      </Entity>
      
      <!-- Entity 4: Account Balance -->
      <Entity id="ENTITY_04">
        <EntityName>AccountBalance</EntityName>
        <EntityType>BALANCE_UPDATE</EntityType>
        <APIEndpoint>PATCH /api/v1/accounts/{account_id}/balance</APIEndpoint>
        <Description>Real-time account balance update</Description>
        
        <Fields>
          <Field name="account_number" type="STRING" mandatory="true"/>
          <Field name="balance_type" type="CODE" mandatory="true" description="AVAILABLE, LEDGER, HOLD"/>
          <Field name="amount_change" type="DECIMAL" mandatory="true"/>
          <Field name="new_balance" type="DECIMAL" mandatory="false"/>
          <Field name="timestamp" type="DATETIME" mandatory="true"/>
        </Fields>
      </Entity>
      
      <!-- Entity 5: Transaction Fees -->
      <Entity id="ENTITY_05">
        <EntityName>TransactionFee</EntityName>
        <EntityType>FEE_POSTING</EntityType>
        <APIEndpoint>POST /api/v1/fees/calculate-and-post</APIEndpoint>
        <Description>Fee calculation and posting</Description>
        
        <Fields>
          <Field name="transaction_id" type="STRING" mandatory="true"/>
          <Field name="fee_type" type="CODE" mandatory="true" description="INCOMING_WIRE, FX, COMMISSION"/>
          <Field name="fee_amount" type="DECIMAL" mandatory="true"/>
          <Field name="fee_currency" type="STRING" mandatory="true"/>
          <Field name="charge_to_account" type="STRING" mandatory="true"/>
          <Field name="revenue_gl_account" type="STRING" mandatory="true"/>
        </Fields>
      </Entity>
      
      <!-- Entity 6: Transaction Log -->
      <Entity id="ENTITY_06">
        <EntityName>TransactionAuditLog</EntityName>
        <EntityType>AUDIT_TRAIL</EntityType>
        <APIEndpoint>POST /api/v1/audit/transactions</APIEndpoint>
        <Description>Complete audit trail for compliance</Description>
        
        <Fields>
          <Field name="log_id" type="STRING" mandatory="true"/>
          <Field name="transaction_id" type="STRING" mandatory="true"/>
          <Field name="message_id" type="STRING" mandatory="true"/>
          <Field name="event_type" type="CODE" mandatory="true"/>
          <Field name="event_timestamp" type="DATETIME" mandatory="true"/>
          <Field name="user_id" type="STRING" mandatory="false"/>
          <Field name="system_id" type="STRING" mandatory="true"/>
          <Field name="before_state" type="JSON" mandatory="false"/>
          <Field name="after_state" type="JSON" mandatory="false"/>
          <Field name="success" type="BOOLEAN" mandatory="true"/>
          <Field name="error_message" type="STRING" mandatory="false"/>
        </Fields>
      </Entity>
      
    </Entities>
  </TargetSystem>
  
  <!-- ============================================= -->
  <!-- FIELD MAPPINGS -->
  <!-- ============================================= -->
  <FieldMappings>
    
    <!-- Mapping 1: Transaction ID -->
    <Mapping id="MAPPING_01">
      <SourceField ref="FIELD_06"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetField>transaction_id</TargetField>
      
      <MappingFormula>
        <Type>DIRECT_COPY</Type>
        <Expression>
          target.transaction_id = source.CdtTrfTxInf_PmtId_TxId
        </Expression>
        <PseudoCode>
          // Use pacs.008 transaction ID as core banking transaction ID
          transaction_id = source.payment_id.transaction_id
          return transaction_id
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>source.TxId != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>DUPLICATE_CHECK</Type>
          <Expression>NOT exists_in_posted_transactions(transaction_id)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Duplicate transaction"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>IDEMPOTENCY_CHECK</Type>
          <Expression>NOT exists_in_processing_queue(transaction_id)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>WAIT or REJECT based on status</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Duplicate posting or transaction rejection</ImpactIfFails>
        <BusinessRationale>
          Unique identifier for idempotency and duplicate detection.
          Critical for preventing double-posting of the same payment.
        </BusinessRationale>
        <PerformanceImpact>MEDIUM (database lookup for duplicate check)</PerformanceImpact>
        <DuplicateDetectionWindow>7 days</DuplicateDetectionWindow>
      </General>
    </Mapping>
    
    <!-- Mapping 2: Account Number -->
    <Mapping id="MAPPING_02">
      <SourceField ref="FIELD_15"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetField>account_number</TargetField>
      
      <MappingFormula>
        <Type>EXTRACTION_WITH_VALIDATION</Type>
        <Expression>
          creditor_iban = source.CdtrAcct_Id_IBAN
          
          // Extract local account number from IBAN
          IF is_local_iban(creditor_iban, our_country_code) THEN
            account_number = extract_account_from_iban(creditor_iban)
          ELSE
            // External IBAN - use nostro posting
            REJECT "Beneficiary not our customer"
          ENDIF
          
          target.account_number = account_number
        </Expression>
        <PseudoCode>
          // Get creditor IBAN
          iban = source.creditor_account.iban
          
          // Validate IBAN format
          if (NOT is_valid_iban(iban)) then
            throw error "Invalid IBAN format"
          endif
          
          // Extract country code
          country_code = substring(iban, 1, 2)
          
          // Check if this is our customer
          our_bank_country = get_config("bank_country_code")  // e.g., "DE"
          
          if (country_code != our_bank_country) then
            throw error "Beneficiary account not held at this bank"
          endif
          
          // Extract BBAN (Basic Bank Account Number) from IBAN
          // IBAN format: CC2!n4!n10!n (e.g., DE89370400440532013000)
          // For Germany: CC + 2 check digits + 8 bank code + 10 account number
          
          if (country_code == "DE") then
            bank_code = substring(iban, 5, 8)
            account_number = substring(iban, 13, 10)
            
            // Verify bank code matches ours
            our_bank_code = get_config("bank_code")
            if (bank_code != our_bank_code) then
              throw error "Account belongs to different bank"
            endif
          else if (country_code == "FR") then
            // France IBAN format different
            bank_code = substring(iban, 5, 5)
            branch_code = substring(iban, 10, 5)
            account_number = substring(iban, 15, 11)
            // ... validation
          endif
          
          // Lookup account in core banking system
          account = core_banking.get_account(account_number)
          
          if (account is null) then
            throw error "Account not found: " + account_number
          endif
          
          if (account.status != "ACTIVE") then
            throw error "Account is closed or blocked"
          endif
          
          return account_number
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>IBAN_VALIDATION</Type>
          <Expression>is_valid_iban(iban)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>LOCAL_ACCOUNT_CHECK</Type>
          <Expression>is_our_customer_account(iban)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>ROUTE_TO_NOSTRO (if we're intermediary)</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>ACCOUNT_STATUS_CHECK</Type>
          <Expression>account.status == "ACTIVE" AND NOT account.is_blocked</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Account inactive or blocked"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>ACCOUNT_TYPE_CHECK</Type>
          <Expression>account.type IN ["CURRENT", "SAVINGS", "CHECKING"]</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid account type for credit"</ElseAction>
        </Condition>
        
        <Condition priority="5">
          <Type>NAME_MATCHING</Type>
          <Expression>fuzzy_match(account.holder_name, source.creditor_name) > 0.8</Expression>
          <Action>PROCEED</Action>
          <ElseAction>FLAG for manual review (potential fraud)</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>Payment credited to wrong account or rejected</ImpactIfFails>
        <BusinessRationale>
          Must identify correct customer account to credit.
          Wrong account = financial loss + regulatory breach.
        </BusinessRationale>
        <PerformanceImpact>HIGH (account lookup + validation checks)</PerformanceImpact>
        <FraudCheck>Name mismatch detection prevents mule account usage</FraudCheck>
        <RegionalNote>
          IBAN structure varies by country:
          - Germany (DE): 22 chars (2 country + 2 check + 8 bank + 10 account)
          - France (FR): 27 chars (2+2+5+5+11+2)
          - UK (GB): 22 chars
          Parser must handle all formats.
        </RegionalNote>
      </General>
    </Mapping>
    
    <!-- Mapping 3: Transaction Type -->
    <Mapping id="MAPPING_03">
      <SourceField ref="NONE"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetField>transaction_type</TargetField>
      
      <MappingFormula>
        <Type>STATIC_VALUE</Type>
        <Expression>
          // pacs.008 is always a credit transfer to the beneficiary
          target.transaction_type = "CREDIT"
        </Expression>
        <PseudoCode>
          // pacs.008 = FI to FI Customer Credit Transfer
          // By definition, this is always a CREDIT to our customer
          transaction_type = "CREDIT"
          return transaction_type
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>ALWAYS_TRUE</Type>
          <Expression>true</Expression>
          <Action>SET_TO_CREDIT</Action>
          <ElseAction>N/A</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>Wrong direction posting (debit instead of credit)</ImpactIfFails>
        <BusinessRationale>
          pacs.008 is by definition a credit transfer message.
          Always credits beneficiary account.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 4: Amount -->
    <Mapping id="MAPPING_04">
      <SourceField ref="FIELD_08"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetField>amount</TargetField>
      <AdditionalSourceFields>
        <SourceField ref="FIELD_07"/>
      </AdditionalSourceFields>
      
      <MappingFormula>
        <Type>AMOUNT_SELECTION_WITH_FX</Type>
        <Expression>
          // Priority 1: Use InstructedAmount (amount before charges)
          IF source.InstdAmt != null THEN
            amount = source.InstdAmt_value
            amount_currency = source.InstdAmt_Ccy
          ELSE
            // Fallback: Use InterbankSettlementAmount
            amount = source.IntrBkSttlmAmt_value
            amount_currency = source.IntrBkSttlmAmt_Ccy
          ENDIF
          
          // Check if FX conversion needed
          account_currency = get_account_currency(account_number)
          
          IF amount_currency != account_currency THEN
            // Currency conversion required
            fx_rate = get_fx_rate(amount_currency, account_currency, value_date)
            converted_amount = amount * fx_rate
            target.amount = converted_amount
            target.currency = account_currency
            
            // Log FX conversion
            log_fx_conversion(amount, amount_currency, converted_amount, account_currency, fx_rate)
          ELSE
            target.amount = amount
            target.currency = amount_currency
          ENDIF
        </Expression>
        <PseudoCode>
          // Get instructed amount (preferred)
          instd_amt = source.instructed_amount
          
          if (instd_amt != null) then
            amount = instd_amt.value
            currency = instd_amt.currency
          else
            // Fallback to settlement amount
            sttlm_amt = source.interbank_settlement_amount
            amount = sttlm_amt.value
            currency = sttlm_amt.currency
          endif
          
          // Get account details
          account = core_banking.get_account(account_number)
          account_currency = account.currency
          
          // Check if FX conversion needed
          if (currency != account_currency) then
            // Multi-currency payment - need FX conversion
            
            // Get FX rate
            fx_service = FX_RATE_SERVICE
            fx_rate = fx_service.get_rate(
              from_currency: currency,
              to_currency: account_currency,
              value_date: value_date,
              rate_type: "MID"  // or BUY/SELL based on policy
            )
            
            if (fx_rate is null) then
              throw error "FX rate not available for " + currency + "/" + account_currency
            endif
            
            // Convert amount
            converted_amount = amount * fx_rate
            
            // Round to account currency precision (typically 2 decimals)
            converted_amount = round(converted_amount, 2)
            
            // Create FX conversion record for audit
            fx_conversion = {
              transaction_id: transaction_id,
              original_amount: amount,
              original_currency: currency,
              converted_amount: converted_amount,
              converted_currency: account_currency,
              fx_rate: fx_rate,
              fx_timestamp: current_timestamp()
            }
            
            core_banking.log_fx_conversion(fx_conversion)
            
            // Use converted amount
            final_amount = converted_amount
            final_currency = account_currency
          else
            // Same currency - no conversion
            final_amount = amount
            final_currency = currency
          endif
          
          return {
            amount: final_amount,
            currency: final_currency
          }
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>AMOUNT_VALIDATION</Type>
          <Expression>amount > 0 AND amount &lt; account.maximum_credit_limit</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT if amount invalid or exceeds limit</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CURRENCY_SUPPORTED_CHECK</Type>
          <Expression>is_supported_currency(currency)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Unsupported currency"</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>FX_RATE_AVAILABILITY</Type>
          <Expression>currency == account_currency OR fx_rate_available(currency, account_currency)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "FX rate not available"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>ACCOUNT_LIMIT_CHECK</Type>
          <Expression>account.balance + amount &lt;= account.maximum_balance</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Account balance limit exceeded"</ElseAction>
        </Condition>
        
        <Condition priority="5">
          <Type>LARGE_AMOUNT_FLAG</Type>
          <Expression>amount &lt; LARGE_AMOUNT_THRESHOLD</Expression>
          <Action>PROCEED</Action>
          <ElseAction>FLAG for compliance review if > threshold (e.g., 10,000 EUR)</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>
          Wrong amount posted = financial discrepancy.
          FX error = exchange rate loss/gain dispute.
        </ImpactIfFails>
        <BusinessRationale>
          Core financial value of the transaction.
          Must handle multi-currency accounts and FX conversion correctly.
        </BusinessRationale>
        <PerformanceImpact>
          HIGH if FX conversion needed (external rate service API call).
          LOW if same currency (simple validation).
        </PerformanceImpact>
        <FXPolicy>
          - Use mid-market rate for customer credit
          - Apply bank's FX margin as separate fee (transparency)
          - Log all FX conversions for audit
          - Support FX rate caching (refresh every 5 minutes)
        </FXPolicy>
        <AccountingNote>
          FX gain/loss should be posted to separate P&L GL account.
        </AccountingNote>
      </General>
    </Mapping>
    
    <!-- Mapping 5: Value Date -->
    <Mapping id="MAPPING_05">
      <SourceField ref="FIELD_09"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetFields>
        <TargetField>value_date</TargetField>
        <TargetField>booking_date</TargetField>
      </TargetFields>
      
      <MappingFormula>
        <Type>DATE_HANDLING_WITH_BACKDATING_RULES</Type>
        <Expression>
          settlement_date = source.IntrBkSttlmDt
          current_date = today()
          
          // Value date is from message
          target.value_date = settlement_date
          
          // Booking date logic
          IF settlement_date > current_date THEN
            // Future-dated payment
            target.booking_date = settlement_date
            target.status = "SCHEDULED"
          ELSE IF settlement_date == current_date THEN
            // Same day
            target.booking_date = current_date
            target.status = "PENDING"
          ELSE
            // Backdated payment
            IF is_allowed_backdate(settlement_date, current_date) THEN
              target.value_date = settlement_date
              target.booking_date = current_date
              target.status = "BACKDATED"
            ELSE
              REJECT "Backdate exceeds allowed period"
            ENDIF
          ENDIF
        </Expression>
        <PseudoCode>
          // Get settlement date from message
          value_date = source.interbank_settlement_date
          current_business_date = core_banking.get_business_date()
          
          // Validate date
          if (NOT is_valid_date(value_date)) then
            throw error "Invalid settlement date"
          endif
          
          // Check if business day
          if (NOT is_business_day(value_date)) then
            log_warning("Settlement date " + value_date + " is not a business day")
            // Some banks reject, others adjust to next business day
            value_date = next_business_day(value_date)
          endif
          
          // Determine booking treatment
          if (value_date > current_business_date) then
            // Future-dated payment
            booking_date = value_date
            transaction_status = "SCHEDULED"
            
            // Schedule for future posting
            scheduler.schedule_transaction(
              transaction_id: transaction_id,
              scheduled_date: value_date
            )
          else if (value_date == current_business_date) then
            // Same-day value
            booking_date = current_business_date
            transaction_status = "PENDING"
            
            // Process immediately
          else
            // Backdated value date
            days_back = current_business_date - value_date
            max_backdate_days = get_config("max_backdate_days", default: 5)
            
            if (days_back > max_backdate_days) then
              throw error "Backdate exceeds maximum allowed period (" + max_backdate_days + " days)"
            endif
            
            // Allow backdating with special handling
            booking_date = current_business_date
            transaction_status = "BACKDATED"
            
            // Log backdating for audit
            audit.log_backdated_transaction(
              transaction_id: transaction_id,
              value_date: value_date,
              booking_date: booking_date,
              days_backdated: days_back
            )
            
            // May require additional approval for regulatory reporting adjustments
          endif
          
          return {
            value_date: value_date,
            booking_date: booking_date,
            status: transaction_status
          }
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>DATE_VALIDATION</Type>
          <Expression>is_valid_date(settlement_date)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>BUSINESS_DAY_CHECK</Type>
          <Expression>is_business_day(settlement_date)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>ADJUST to next business day AND LOG</ElseAction>
        </Condition>
        
        <Condition priority="3">
          <Type>BACKDATE_LIMIT_CHECK</Type>
          <Expression>settlement_date >= current_date - MAX_BACKDATE_DAYS</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Excessive backdating"</ElseAction>
        </Condition>
        
        <Condition priority="4">
          <Type>FUTURE_DATE_LIMIT</Type>
          <Expression>settlement_date &lt;= current_date + MAX_FUTURE_DAYS</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Future date too far"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>
          Wrong value date = interest calculation errors, regulatory reporting issues.
          Incorrect backdating = audit findings.
        </ImpactIfFails>
        <BusinessRationale>
          Value date determines when funds are available and when interest accrues.
          Critical for customer balance availability and bank liquidity management.
        </BusinessRationale>
        <PerformanceImpact>LOW (date calculation and validation)</PerformanceImpact>
        <RegulatoryNote>
          - Central bank reporting uses value date
          - Backdating >5 days may require explanation
          - Future-dated >30 days may require special authorization
        </RegulatoryNote>
        <PolicyConfiguration>
          MAX_BACKDATE_DAYS: 5 (configurable)
          MAX_FUTURE_DAYS: 90 (configurable)
          AUTO_ADJUST_NON_BUSINESS_DAYS: true
        </PolicyConfiguration>
      </General>
    </Mapping>
    
    <!-- Mapping 6: Description/Narrative -->
    <Mapping id="MAPPING_06">
      <SourceField ref="FIELD_17"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetFields>
        <TargetField>description</TargetField>
        <TargetField>reference</TargetField>
      </TargetFields>
      <AdditionalSourceFields>
        <SourceField ref="FIELD_05"/>
        <SourceField ref="FIELD_11"/>
      </AdditionalSourceFields>
      
      <MappingFormula>
        <Type>NARRATIVE_CONSTRUCTION</Type>
        <Expression>
          remittance = source.RmtInf_Ustrd
          debtor_name = source.Dbtr_Nm
          end_to_end_id = source.EndToEndId
          
          // Build transaction description for customer statement
          IF remittance != null THEN
            description = remittance
          ELSE
            // Construct from available info
            description = "Credit transfer from " + truncate(debtor_name, 50)
          ENDIF
          
          target.description = truncate(description, 140)
          target.reference = end_to_end_id
        </Expression>
        <PseudoCode>
          // Get remittance information
          remittance_text = source.remittance_info.unstructured
          
          // Get other descriptive fields
          debtor_name = source.debtor.name
          end_to_end_ref = source.payment_id.end_to_end_id
          
          // Build description for statement/online banking display
          if (remittance_text != null AND remittance_text != "") then
            // Use remittance as primary description
            description = remittance_text
          else
            // Construct descriptive text
            description = "Incoming payment from " + debtor_name
          endif
          
          // Truncate to field limit
          if (length(description) > 140) then
            description = substring(description, 1, 137) + "..."
          endif
          
          // Set reference for reconciliation
          reference = end_to_end_ref
          
          return {
            description: description,
            reference: reference
          }
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>LENGTH_CHECK</Type>
          <Expression>length(description) &lt;= 140</Expression>
          <Action>PROCEED</Action>
          <ElseAction>TRUNCATE</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CONTENT_SCREENING</Type>
          <Expression>NOT contains_prohibited_content(description)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>SANITIZE or FLAG for review</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>
          Poor customer experience (unclear statement).
          Reconciliation difficulties.
        </ImpactIfFails>
        <BusinessRationale>
          Provides context for customer to identify payment source.
          Critical for reconciliation and dispute resolution.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 7: Originator Information -->
    <Mapping id="MAPPING_07">
      <SourceField ref="FIELD_11"/>
      <TargetEntity ref="ENTITY_01"/>
      <TargetFields>
        <TargetField>originator_name</TargetField>
        <TargetField>originator_account</TargetField>
      </TargetFields>
      <AdditionalSourceFields>
        <SourceField ref="FIELD_12"/>
      </AdditionalSourceFields>
      
      <MappingFormula>
        <Type>DIRECT_COPY</Type>
        <Expression>
          target.originator_name = source.Dbtr_Nm
          target.originator_account = source.DbtrAcct_Id_IBAN
        </Expression>
        <PseudoCode>
          // Copy debtor info as originator
          originator_name = source.debtor.name
          originator_account = source.debtor_account.iban
          
          return {
            originator_name: originator_name,
            originator_account: originator_account
          }
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>MANDATORY_CHECK</Type>
          <Expression>originator_name != null</Expression>
          <Action>PROCEED</Action>
          <ElseAction>SET_TO_UNKNOWN</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>HIGH</Criticality>
        <ImpactIfFails>AML compliance violation</ImpactIfFails>
        <BusinessRationale>
          Required for FATF Travel Rule compliance.
          Originator info must be stored with transaction.
        </BusinessRationale>
        <PerformanceImpact>NEGLIGIBLE</PerformanceImpact>
      </General>
    </Mapping>
    
    <!-- Mapping 8: GL Posting (Double Entry) -->
    <Mapping id="MAPPING_08">
      <SourceFields>
        <SourceField ref="FIELD_08"/>
        <SourceField ref="FIELD_15"/>
      </SourceFields>
      <TargetEntity ref="ENTITY_02"/>
      
      <MappingFormula>
        <Type>DOUBLE_ENTRY_ACCOUNTING</Type>
        <Expression>
          amount = mapped_amount
          account_number = mapped_account_number
          
          // Determine GL accounts based on transaction type and account type
          account_info = get_account_info(account_number)
          customer_gl_account = get_customer_gl_account(account_info.category)
          nostro_gl_account = get_nostro_gl_account(correspondent_bank_bic, currency)
          
          // Create double entry
          // Entry 1: Debit Nostro (asset increase)
          gl_entry_1 = {
            gl_account: nostro_gl_account,
            debit_amount: amount,
            credit_amount: 0,
            description: "Incoming payment from " + correspondent_bank
          }
          
          // Entry 2: Credit Customer Liability (liability increase)
          gl_entry_2 = {
            gl_account: customer_gl_account,
            debit_amount: 0,
            credit_amount: amount,
            description: "Credit customer account " + account_number
          }
          
          target = [gl_entry_1, gl_entry_2]
        </Expression>
        <PseudoCode>
          // Double-entry bookkeeping for incoming payment
          
          amount = transaction_amount
          currency = transaction_currency
          account = customer_account
          correspondent_bank = source.instructing_agent.bic
          
          // Get GL account codes from configuration
          gl_config = CHART_OF_ACCOUNTS
          
          // Customer account type determines GL account
          if (account.type == "CHECKING") then
            customer_gl = gl_config.get("CUSTOMER_CHECKING_ACCOUNTS")  // e.g., "2100"
          else if (account.type == "SAVINGS") then
            customer_gl = gl_config.get("CUSTOMER_SAVINGS_ACCOUNTS")   // e.g., "2200"
          endif
          
          // Nostro account for interbank settlement
          nostro_gl = gl_config.get("NOSTRO_ACCOUNT_" + correspondent_bank + "_" + currency)
          // e.g., "1050-SOGEFRPP-EUR" for Société Générale EUR nostro
          
          // Create GL entries (double-entry)
          entries = []
          
          // Entry 1: Debit Nostro (we expect funds from correspondent)
          entries.add({
            entry_id: generate_uuid(),
            transaction_id: transaction_id,
            gl_account: nostro_gl,
            debit_amount: amount,
            credit_amount: 0,
            currency: currency,
            value_date: value_date,
            description: "DR Nostro - Incoming pacs.008 from " + correspondent_bank
          })
          
          // Entry 2: Credit Customer Account (increase liability)
          entries.add({
            entry_id: generate_uuid(),
            transaction_id: transaction_id,
            gl_account: customer_gl,
            debit_amount: 0,
            credit_amount: amount,
            currency: currency,
            value_date: value_date,
            description: "CR Customer " + account_number + " - " + debtor_name
          })
          
          // Verify double-entry balance
          total_debit = sum(entries, "debit_amount")
          total_credit = sum(entries, "credit_amount")
          
          if (total_debit != total_credit) then
            throw error "GL entries not balanced"
          endif
          
          return entries
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>BALANCED_ENTRIES</Type>
          <Expression>sum(debit_amounts) == sum(credit_amounts)</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Unbalanced GL entries"</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>GL_ACCOUNT_VALIDATION</Type>
          <Expression>all_gl_accounts_exist_in_chart_of_accounts()</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT with error "Invalid GL account"</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>
          Financial statements incorrect.
          Audit failure.
          Regulatory reporting errors.
        </ImpactIfFails>
        <BusinessRationale>
          Every transaction must have balanced double-entry GL posting.
          Foundation of bank's financial accounting.
        </BusinessRationale>
        <PerformanceImpact>MEDIUM (multiple GL entries, validation)</PerformanceImpact>
        <AccountingStandard>IFRS 9, Basel III</AccountingStandard>
        <ChartOfAccounts>
          - 1000-1999: Assets (Nostro accounts, Cash)
          - 2000-2999: Liabilities (Customer deposits)
          - 3000-3999: Equity
          - 4000-4999: Revenue (Fees, Interest income)
          - 5000-5999: Expenses
        </ChartOfAccounts>
      </General>
    </Mapping>
    
    <!-- Mapping 9: Balance Update -->
    <Mapping id="MAPPING_09">
      <SourceField ref="FIELD_08"/>
      <TargetEntity ref="ENTITY_04"/>
      
      <MappingFormula>
        <Type>REAL_TIME_BALANCE_UPDATE</Type>
        <Expression>
          account_number = mapped_account_number
          credit_amount = mapped_amount
          
          // Acquire row-level lock on account
          LOCK account FOR UPDATE
          
          // Get current balances
          current_ledger_balance = account.ledger_balance
          current_available_balance = account.available_balance
          
          // Update balances
          new_ledger_balance = current_ledger_balance + credit_amount
          new_available_balance = current_available_balance + credit_amount
          
          // Check minimum balance requirements
          IF new_ledger_balance < account.minimum_balance THEN
            log_warning("Account below minimum balance")
          ENDIF
          
          target = {
            account_number: account_number,
            balance_type: "LEDGER",
            amount_change: credit_amount,
            new_balance: new_ledger_balance
          }
          
          UNLOCK account
        </Expression>
        <PseudoCode>
          // Real-time balance update with concurrency control
          
          account_number = transaction.account_number
          credit_amount = transaction.amount
          
          // Start database transaction
          db.begin_transaction()
          
          try {
            // Lock account record for update (prevent concurrent modifications)
            account = db.lock_for_update("accounts", account_number)
            
            // Read current balances
            ledger_balance = account.ledger_balance
            available_balance = account.available_balance
            hold_balance = account.hold_balance
            
            // Update ledger balance (book balance)
            new_ledger_balance = ledger_balance + credit_amount
            
            // Update available balance (credit is immediately available)
            new_available_balance = available_balance + credit_amount
            
            // Validate new balances
            if (new_ledger_balance < 0) then
              throw error "Negative balance not allowed"
            endif
            
            // Check account limits
            if (new_ledger_balance > account.maximum_balance) then
              throw error "Maximum balance exceeded"
            endif
            
            // Update account record
            account.ledger_balance = new_ledger_balance
            account.available_balance = new_available_balance
            account.last_transaction_date = current_date()
            account.last_credit_date = current_date()
            account.last_credit_amount = credit_amount
            
            // Save changes
            db.update(account)
            
            // Create balance audit record
            balance_audit = {
              account_number: account_number,
              transaction_id: transaction_id,
              balance_type: "LEDGER",
              old_balance: ledger_balance,
              amount_change: credit_amount,
              new_balance: new_ledger_balance,
              timestamp: current_timestamp()
            }
            
            db.insert("balance_audit", balance_audit)
            
            // Commit transaction
            db.commit()
            
            // Trigger real-time events
            event_bus.publish("BALANCE_UPDATED", {
              account_number: account_number,
              new_balance: new_ledger_balance,
              transaction_id: transaction_id
            })
            
            // Check for alerts (low balance, high balance, etc.)
            alert_service.check_balance_alerts(account_number, new_ledger_balance)
            
            return {
              success: true,
              new_ledger_balance: new_ledger_balance,
              new_available_balance: new_available_balance
            }
            
          } catch (error) {
            // Rollback on any error
            db.rollback()
            throw error
          }
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>BALANCE_VALIDATION</Type>
          <Expression>new_balance >= 0 AND new_balance &lt;= max_balance</Expression>
          <Action>PROCEED</Action>
          <ElseAction>REJECT</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>CONCURRENCY_CHECK</Type>
          <Expression>account_lock_acquired successfully</Expression>
          <Action>PROCEED</Action>
          <ElseAction>RETRY or REJECT</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>CRITICAL</Criticality>
        <ImpactIfFails>
          Balance discrepancy.
          Customer cannot access funds.
          Overdraft issues.
        </ImpactIfFails>
        <BusinessRationale>
          Real-time balance availability for customers.
          Foundation of account services.
        </BusinessRationale>
        <PerformanceImpact>HIGH (row-level lock, database update)</PerformanceImpact>
        <ConcurrencyControl>
          Pessimistic locking (row-level lock) to prevent race conditions.
          Lock timeout: 5 seconds.
        </ConcurrencyControl>
        <BalanceTypes>
          - Ledger Balance: Book balance (all posted transactions)
          - Available Balance: Ledger - Holds + Credits not yet cleared
          - Hold Balance: Amounts reserved (checks, authorizations)
        </BalanceTypes>
      </General>
    </Mapping>
    
    <!-- Mapping 10: Fees -->
    <Mapping id="MAPPING_10">
      <SourceFields>
        <SourceField ref="FIELD_08"/>
        <SourceField ref="FIELD_10"/>
      </SourceFields>
      <TargetEntity ref="ENTITY_05"/>
      
      <MappingFormula>
        <Type>FEE_CALCULATION</Type>
        <Expression>
          amount = transaction_amount
          charge_bearer = source.ChrgBr
          account = customer_account
          
          // Determine applicable fees
          fees = calculate_fees(
            transaction_type: "INCOMING_WIRE",
            amount: amount,
            currency: currency,
            account_type: account.type,
            customer_segment: account.customer_segment
          )
          
          // Check charge bearer
          IF charge_bearer == "CRED" OR charge_bearer == "SHAR" THEN
            // Beneficiary pays fees
            IF fees.total > 0 THEN
              target = {
                transaction_id: transaction_id,
                fee_type: "INCOMING_WIRE_FEE",
                fee_amount: fees.total,
                fee_currency: currency,
                charge_to_account: account_number,
                revenue_gl_account: "4100"  // Fee revenue GL
              }
            ENDIF
          ELSE
            // Debtor pays (no fee to our customer)
            target = null
          ENDIF
        </Expression>
        <PseudoCode>
          // Fee calculation based on bank's fee schedule
          
          transaction_type = "INCOMING_INTERNATIONAL_WIRE"
          amount = transaction_amount
          currency = transaction_currency
          account = customer_account
          charge_bearer = source.charge_bearer
          
          // Get fee schedule
          fee_schedule = FEE_SCHEDULE_SERVICE.get_fees(
            transaction_type: transaction_type,
            customer_segment: account.customer_segment,  // RETAIL, CORPORATE, PREMIUM
            account_type: account.type
          )
          
          // Calculate fee
          if (fee_schedule.type == "FLAT") then
            fee_amount = fee_schedule.amount
          else if (fee_schedule.type == "PERCENTAGE") then
            fee_amount = amount * fee_schedule.percentage
            // Apply min/max
            if (fee_amount < fee_schedule.minimum) then
              fee_amount = fee_schedule.minimum
            endif
            if (fee_amount > fee_schedule.maximum) then
              fee_amount = fee_schedule.maximum
            endif
          endif
          
          // Check if customer pays fee
          if (charge_bearer == "CRED" OR charge_bearer == "SHAR") then
            // Customer pays fee
            
            if (fee_amount > 0) then
              // Create fee transaction
              fee_transaction = {
                transaction_id: transaction_id + "_FEE",
                parent_transaction_id: transaction_id,
                fee_type: "INCOMING_WIRE",
                fee_amount: fee_amount,
                fee_currency: currency,
                charge_to_account: account_number,
                revenue_gl_account: get_gl_account("FEE_REVENUE_WIRE"),
                description: "Incoming wire fee",
                status: "PENDING"
              }
              
              // Debit fee from customer account
              account.ledger_balance = account.ledger_balance - fee_amount
              account.available_balance = account.available_balance - fee_amount
              
              return fee_transaction
            else
              return null  // No fee
            endif
          else
            // Debtor pays fee (not our customer)
            return null
          endif
        </PseudoCode>
      </MappingFormula>
      
      <Conditions>
        <Condition priority="1">
          <Type>FEE_SCHEDULE_CHECK</Type>
          <Expression>fee_schedule_exists_for_transaction_type</Expression>
          <Action>PROCEED</Action>
          <ElseAction>USE_DEFAULT_FEE</ElseAction>
        </Condition>
        
        <Condition priority="2">
          <Type>SUFFICIENT_BALANCE</Type>
          <Expression>account.available_balance >= fee_amount</Expression>
          <Action>PROCEED</Action>
          <ElseAction>WAIVE_FEE or REJECT transaction</ElseAction>
        </Condition>
      </Conditions>
      
      <General>
        <Criticality>MEDIUM</Criticality>
        <ImpactIfFails>
          Revenue loss if fee not charged.
          Customer dispute if fee incorrect.
        </ImpactIfFails>
        <BusinessRationale>
          Bank revenue from payment processing.
          Cost recovery for correspondent banking.
        </BusinessRationale>
        <PerformanceImpact>MEDIUM (fee calculation, balance check)</PerformanceImpact>
        <FeeScheduleExample>
          RETAIL: 5 EUR flat fee
          CORPORATE: 0.1% with min 10 EUR, max 50 EUR
          PREMIUM: Fee waived
        </FeeScheduleExample>
      </General>
    </Mapping>
    
  </FieldMappings>
  
  <!-- ============================================= -->
  <!-- VALIDATION RULES -->
  <!-- ============================================= -->
  <ValidationRules>
    <PrePostingValidations>
      <Rule id="VAL_001" type="ACCOUNT_VALIDATION">
        <Description>Validate account exists and is active</Description>
        <Checks>
          <Check>Account exists in core banking</Check>
          <Check>Account status is ACTIVE</Check>
          <Check>Account not blocked/frozen</Check>
          <Check>Account type allows credits</Check>
        </Checks>
        <Action>REJECT if validation fails</Action>
      </Rule>
      
      <Rule id="VAL_002" type="DUPLICATE_CHECK">
        <Description>Prevent duplicate posting</Description>
        <LookupWindow>7 days</LookupWindow>
        <MatchCriteria>
          <Criteria>transaction_id</Criteria>
          <Criteria>end_to_end_id</Criteria>
        </MatchCriteria>
        <Action>REJECT if duplicate found</Action>
      </Rule>
      
      <Rule id="VAL_003" type="BALANCE_LIMIT_CHECK">
        <Description>Ensure account limits not exceeded</Description>
        <Checks>
          <Check>New balance &lt;= maximum_balance</Check>
          <Check>Daily credit limit not exceeded</Check>
        </Checks>
        <Action>REJECT if limit exceeded</Action>
      </Rule>
      
      <Rule id="VAL_004" type="AML_SCREENING">
        <Description>AML transaction monitoring</Description>
        <Checks>
          <Check>Amount below threshold or reported</Check>
          <Check>Originator not on sanctions list</Check>
          <Check>Pattern analysis (velocity, structuring)</Check>
        </Checks>
        <Action>FLAG for review if suspicious</Action>
      </Rule>
    </PrePostingValidations>
    
    <PostPostingValidations>
      <Rule id="VAL_005" type="BALANCE_RECONCILIATION">
        <Description>Verify balance updated correctly</Description>
        <Check>account.ledger_balance == previous_balance + amount</Check>
        <Action>ALERT if mismatch</Action>
      </Rule>
      
      <Rule id="VAL_006" type="GL_BALANCE_CHECK">
        <Description>Verify GL entries balanced</Description>
        <Check>sum(debit) == sum(credit)</Check>
        <Action>ALERT if unbalanced</Action>
      </Rule>
    </PostPostingValidations>
  </ValidationRules>
  
  <!-- ============================================= -->
  <!-- ERROR HANDLING & ROLLBACK -->
  <!-- ============================================= -->
  <ErrorHandling>
    <TransactionManagement>
      <IsolationLevel>READ_COMMITTED</IsolationLevel>
      <RollbackPolicy>AUTOMATIC on any error</RollbackPolicy>
      <RetryPolicy>
        <MaxRetries>3</MaxRetries>
        <RetryableErrors>DEADLOCK, TIMEOUT, TEMPORARY_UNAVAILABLE</RetryableErrors>
        <NonRetryableErrors>ACCOUNT_NOT_FOUND, DUPLICATE, BALANCE_EXCEEDED</NonRetryableErrors>
      </RetryPolicy>
    </TransactionManagement>
    
    <ErrorCategories>
      <Category name="ACCOUNT_ERROR" severity="ERROR" action="REJECT">
        <Description>Account validation failed</Description>
        <Examples>Account not found, Account closed, Account blocked</Examples>
        <RecoveryAction>Return pacs.002 reject message to sender</RecoveryAction>
      </Category>
      
      <Category name="BALANCE_ERROR" severity="ERROR" action="REJECT">
        <Description>Balance limit exceeded</Description>
        <RecoveryAction>Return pacs.002 reject with reason code</RecoveryAction>
      </Category>
      
      <Category name="DUPLICATE_ERROR" severity="ERROR" action="REJECT">
        <Description>Transaction already posted</Description>
        <RecoveryAction>Return pacs.002 success (idempotent)</RecoveryAction>
      </Category>
      
      <Category name="SYSTEM_ERROR" severity="CRITICAL" action="RETRY_THEN_QUEUE">
        <Description>Core banking system unavailable</Description>
        <RecoveryAction>Retry 3 times, then queue for manual processing</RecoveryAction>
      </Category>
      
      <Category name="AML_HIT" severity="HIGH" action="HOLD">
        <Description>AML screening flagged transaction</Description>
        <RecoveryAction>Hold in compliance queue for review</RecoveryAction>
        <Notification>Alert compliance team immediately</Notification>
      </Category>
    </ErrorCategories>
    
    <CompensatingTransactions>
      <Purpose>Reverse posted transaction if subsequent step fails</Purpose>
      <Trigger>Post-posting validation failure or downstream error</Trigger>
      <Process>
        <Step>Create reversal transaction with type "REVERSAL"</Step>
        <Step>Post equal and opposite GL entries</Step>
        <Step>Update account balance (restore previous state)</Step>
        <Step>Mark original transaction as "REVERSED"</Step>
        <Step>Log reversal reason for audit</Step>
        <Step>Send pacs.004 return message to sender</Step>
      </Process>
    </CompensatingTransactions>
  </ErrorHandling>
  
  <!-- ============================================= -->
  <!-- PERFORMANCE & MONITORING -->
  <!-- ============================================= -->
  <PerformanceMetrics>
    <SLA>
      <PostingTime target="250ms" max="3000ms" percentile="99"/>
      <SuccessRate target="99.99%" measurement="DAILY"/>
      <Throughput target="5000 transactions/second" peak="10000 tps"/>
      <AccountLockDuration target="<50ms" max="5000ms"/>
    </SLA>
    
    <Monitoring>
      <Metric name="posting_duration_ms" type="HISTOGRAM"/>
      <Metric name="account_lock_wait_time_ms" type="HISTOGRAM"/>
      <Metric name="gl_posting_duration_ms" type="HISTOGRAM"/>
      <Metric name="balance_update_duration_ms" type="HISTOGRAM"/>
      <Metric name="duplicate_detection_rate" type="GAUGE"/>
      <Metric name="posting_success_rate" type="GAUGE"/>
      <Metric name="rollback_rate" type="COUNTER"/>
      <Metric name="aml_flag_rate" type="GAUGE"/>
      
      <Alert condition="posting_duration_ms > 3000" severity="WARNING"/>
      <Alert condition="posting_success_rate < 0.9999" severity="CRITICAL"/>
      <Alert condition="account_lock_wait_time_ms > 1000" severity="HIGH" description="Contention detected"/>
      <Alert condition="rollback_rate > 100/hour" severity="HIGH"/>
    </Monitoring>
    
    <Optimizations>
      <Optimization name="CONNECTION_POOLING">
        <Description>Maintain 100 DB connections in pool</Description>
        <ImpactEstimate>50% latency reduction</ImpactEstimate>
      </Optimization>
      
      <Optimization name="BATCH_GL_POSTING">
        <Description>Batch GL entries every 100ms</Description>
        <ImpactEstimate>30% throughput improvement</ImpactEstimate>
      </Optimization>
      
      <Optimization name="ASYNC_AUDIT_LOGGING">
        <Description>Write audit logs asynchronously</Description>
        <ImpactEstimate>20ms saving per transaction</ImpactEstimate>
      </Optimization>
    </Optimizations>
  </PerformanceMetrics>
  
  <!-- ============================================= -->
  <!-- AUDIT & COMPLIANCE -->
  <!-- ============================================= -->
  <AuditConfiguration>
    <LoggingPolicy>
      <LogLevel>DEBUG</LogLevel>
      <LogAllTransactions>true</LogAllTransactions>
      <LogFields>
        message_id, transaction_id, account_number, amount, currency,
        originator_name, originator_account, value_date, posting_timestamp,
        success, error_code, error_message, gl_entries, balance_before, balance_after
      </LogFields>
      <RetentionPeriod>10_YEARS</RetentionPeriod>
      <EncryptionRequired>true</EncryptionRequired>
    </LoggingPolicy>
    
    <ComplianceRequirements>
      <Requirement regulation="Basel_III">
        <Mandate>Accurate liquidity reporting</Mandate>
        <Implementation>Real-time balance updates feed LCR calculations</Implementation>
      </Requirement>
      
      <Requirement regulation="IFRS_9">
        <Mandate>Accurate financial reporting</Mandate>
        <Implementation>GL postings feed financial statements</Implementation>
      </Requirement>
      
      <Requirement regulation="AML_CFT">
        <Mandate>Transaction monitoring and reporting</Mandate>
        <Implementation>
          - Store originator information per FATF Travel Rule
          - Flag large transactions (>10,000 EUR)
          - Monitor for structuring patterns
          - Report suspicious activity (SAR)
        </Implementation>
      </Requirement>
      
      <Requirement regulation="GDPR">
        <Mandate>Customer data protection</Mandate>
        <Implementation>
          - Encrypt PII in logs
          - Access controls on customer data
          - Audit all data access
        </Implementation>
      </Requirement>
    </ComplianceRequirements>
    
    <ReconciliationControls>
      <Control type="DAILY_BALANCE_RECONCILIATION">
        <Description>Reconcile account balances with GL daily</Description>
        <Frequency>Daily at EOD</Frequency>
        <Tolerance>0.01 currency unit</Tolerance>
        <Action>Alert if out of balance</Action>
      </Control>
      
      <Control type="NOSTRO_RECONCILIATION">
        <Description>Reconcile nostro accounts with statements</Description>
        <Frequency>Daily</Frequency>
        <Action>Flag unmatched items for investigation</Action>
      </Control>
    </ReconciliationControls>
  </AuditConfiguration>
  
</MessageMapping>